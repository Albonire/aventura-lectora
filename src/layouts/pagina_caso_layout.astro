---
import type { CollectionEntry } from 'astro:content';
import CursoLayout from './curso_layout.astro';
import EncabezadoPagina from '../components/curso/encabezado_pagina.astro';
import PasosCaso from '../components/curso/pasos_caso.astro';
import Estrategias from '../components/ui/estrategias.astro';
import Portada1 from '../components/ilustraciones/portadas/portada_1.astro';
import Portada2 from '../components/ilustraciones/portadas/portada_2.astro';
import Portada3 from '../components/ilustraciones/portadas/portada_3.astro';
import Portada4 from '../components/ilustraciones/portadas/portada_4.astro';
import { BadgeTracker } from '../components/islas/badge_tracker';
import { Autoevaluacion } from '../components/islas/autoevaluacion';
import { ReadAloud } from '../components/islas/read_aloud';
import { estacion_de_caso, folio, pagina_por_slug, type SlugPagina } from '../config/paginas';

interface Props {
  unidad: CollectionEntry<'unidades'>;
  pagina: SlugPagina;
}
const { unidad, pagina } = Astro.props;
const info = pagina_por_slug(pagina);
if (!info) throw new Error(`pagina desconocida: ${pagina}`);
const d = unidad.data;
const estacion = estacion_de_caso(d.numero);

const titulo_pagina =
  pagina === 'abrir'
    ? `${estacion.etiqueta}: ${estacion.titulo}`
    : `${info.titulo}. ${estacion.etiqueta}: ${estacion.titulo}`;
const descripcion_pagina =
  pagina === 'abrir'
    ? `${estacion.etiqueta} de Aventura lectora: ${estacion.titulo}. ${d.mision}`
    : `${info.titulo}, ${estacion.etiqueta} de Aventura lectora: ${estacion.titulo}. ${info.descripcion}`;
const Portada = { 1: Portada1, 2: Portada2, 3: Portada3, 4: Portada4 }[d.numero as 1 | 2 | 3 | 4];
---

<CursoLayout
  titulo={titulo_pagina}
  descripcion={descripcion_pagina}
  ubicacion={{ tipo: 'caso', caso: d.numero, pagina }}
>
  {
    pagina === 'abrir' ? (
      <Portada titulo={estacion.titulo} alt={d.imagen_portada.alt} />
    ) : (
      <EncabezadoPagina
        etiqueta={`${estacion.etiqueta}: ${estacion.titulo}. ${folio(pagina)}`}
        titulo={info.titulo}
        color={d.color}
      >
        <p>{info.descripcion}</p>
      </EncabezadoPagina>
    )
  }

  <PasosCaso caso={d.numero} actual={pagina} />

  {
    pagina === 'abrir' && (
      <section id="mision" aria-labelledby="mision-titulo" class="scroll-mt-20 py-8 md:py-12">
        <div class="contenedor">
          <div class="max-w-4xl rounded-card border-2 border-ink-black bg-pure-white p-5 md:p-8">
            <p class="interfaz text-body-sm font-medium text-stone-text">
              {estacion.etiqueta} · {d.duracion}
            </p>
            <h2 id="mision-titulo" class="mt-1 text-heading-sm leading-tight">
              Tu misión
            </h2>
            <p class="mt-3 max-w-reading text-reading">{d.mision}</p>
            <div class="mt-4">
              <ReadAloud client:idle texto={d.mision} tamano="chico" />
            </div>
            <p class="mt-4 text-body">
              <span class="font-bold">Te acompaña:</span> {d.guia}.
            </p>
            {d.estrategias.length > 0 && (
              <div class="mt-5 border-t-2 border-hairline-mist pt-4">
                <p class="interfaz mb-3 text-body-sm font-medium text-stone-text">
                  Tus tres trucos de detective
                </p>
                <Estrategias items={d.estrategias} />
              </div>
            )}

            <details class="group mt-6 rounded-soft bg-cream-paper">
              <summary class="interfaz flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 rounded-soft px-4 text-body-sm font-medium [&::-webkit-details-marker]:hidden">
                Para docentes: aprendizajes y referentes
                <span class="text-stone-text group-open:hidden" aria-hidden="true">
                  Abrir
                </span>
                <span class="hidden text-stone-text group-open:inline" aria-hidden="true">
                  Cerrar
                </span>
              </summary>
              <div class="space-y-4 px-4 pb-5 text-body-sm">
                <div>
                  <p class="font-medium">Aprendizajes esperados</p>
                  <ul class="mt-1 list-disc space-y-1 pl-5 text-stone-text">
                    {d.aprendizajes_esperados.map((a) => (
                      <li>{a}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p class="font-medium">Derechos Básicos de Aprendizaje</p>
                  <ul class="mt-1 list-disc space-y-1 pl-5 text-stone-text">
                    {d.referentes.map((a) => (
                      <li>{a}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </details>
          </div>
        </div>
      </section>
    )
  }

  <slot />

  {
    pagina === 'cerrar' && (
      <section
        id="cierre-caso"
        aria-labelledby="cierre-titulo"
        class="scroll-mt-20 py-8 md:py-12"
      >
        <div class="contenedor">
          <h2 id="cierre-titulo" class="text-heading-sm leading-tight">
            Gana tu medalla
          </h2>

          <div class="mt-5 grid gap-6 lg:grid-cols-2">
            <BadgeTracker client:visible modo="caso" unidad={d.numero} />
            <Autoevaluacion client:visible unidad={d.numero} />
          </div>

          <div class="mt-6 max-w-3xl rounded-soft border-2 border-ink-black bg-sunshine-pop p-4">
            <p class="interfaz text-body-sm font-bold">Para conversar en casa</p>
            <p class="mt-1 text-body">{d.para_familias}</p>
          </div>
        </div>
      </section>
    )
  }
</CursoLayout>
