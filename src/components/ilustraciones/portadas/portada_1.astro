---
// mission 1: Sofía reads with her magnifying glass, with the rabbit of the red scarf and the tortoise
import PortadaCapitulo from '../../libro/portada_capitulo.astro';
import EscenaBase from '../escena_base.astro';
import Plantas from '../plantas.astro';
import Sofia from '../sofia.astro';
import Conejo from '../conejo.astro';
import Tortuga from '../tortuga.astro';
import Libro from '../libro.astro';

interface Props {
  titulo: string;
  alt: string;
}
const { titulo, alt } = Astro.props;
---

<PortadaCapitulo numero={1} titulo={titulo} color="fresh-grass" alt={alt}>
  <svg viewBox="0 0 560 440" class="block h-auto w-full" focusable="false" aria-hidden="true">
    <EscenaBase />
    <Plantas tipo="hojas" x={14} y={276} escala={1.2} />
    <Plantas tipo="flor" x={2} y={348} escala={0.56} color="#f43f5e" />
    <Plantas tipo="mata" x={452} y={296} escala={1.05} espejo />
    <Plantas tipo="flor" x={506} y={350} escala={0.52} color="#a78bfa" />
    <Plantas tipo="pasto" x={364} y={350} escala={0.5} />
    <g transform="translate(346 318)">
      <Libro size={74} />
    </g>
    <g transform="translate(146 66)">
      <Sofia size={346} pose="lupa" />
    </g>
    <g transform="translate(70 280)">
      <Conejo size={132} />
    </g>
    <g transform="translate(424 330)">
      <Tortuga size={78} />
    </g>
  </svg>
</PortadaCapitulo>
