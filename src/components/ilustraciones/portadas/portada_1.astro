---
import PortadaCapitulo from '../../libro/portada_capitulo.astro';
import Sofia from '../sofia.astro';
import Liebre from '../liebre.astro';
import Tortuga from '../tortuga.astro';
import Libro from '../libro.astro';

interface Props {
  titulo: string;
  alt: string;
}
const { titulo, alt } = Astro.props;
---

<PortadaCapitulo numero={1} titulo={titulo} color="fresh-grass" alt={alt}>
  <svg
    slot="fondo"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <circle cx="640" cy="140" r="84" fill="#f5e211"></circle>
    <g fill="#ffffff">
      <ellipse cx="150" cy="170" rx="86" ry="30"></ellipse>
      <ellipse cx="200" cy="146" rx="52" ry="34"></ellipse>
      <ellipse cx="420" cy="92" rx="70" ry="24"></ellipse>
      <ellipse cx="462" cy="74" rx="40" ry="26"></ellipse>
    </g>
    <path
      d="M0 610 C180 520 360 540 560 470 C660 436 740 440 800 456 V800 H0 Z"
      fill="#6fbb47"
    ></path>
  </svg>
  <svg
    slot="medio"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <path d="M250 800 C330 640 540 560 800 570 V800 Z" fill="#f5f1e4"></path>
    <path
      d="M330 800 C420 690 560 640 800 646"
      stroke="#e0dbce"
      stroke-width="34"
      stroke-linecap="round"
      fill="none"
    ></path>
    <g transform="translate(640 380)">
      <rect x="-16" y="10" width="32" height="190" rx="10" fill="#8b6b4a"></rect>
      <circle cx="0" cy="-20" r="84" fill="#4f9a34"></circle>
      <circle cx="-62" cy="14" r="58" fill="#4f9a34"></circle>
      <circle cx="64" cy="18" r="56" fill="#5aa03a"></circle>
      <circle cx="-14" cy="-66" r="46" fill="#5aa03a"></circle>
    </g>
    <g transform="translate(180 650)">
      <rect x="0" y="-120" width="10" height="150" rx="4" fill="#2c2e2a"></rect>
      <path d="M10 -120 L74 -100 L10 -78 Z" fill="#ff705d"></path>
    </g>
  </svg>
  <svg
    slot="frente"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <g transform="translate(250 250)">
      <Sofia size={430} pose="lupa" />
    </g>
    <g transform="translate(60 610)">
      <Libro size={130} />
    </g>
    <g transform="translate(410 650)">
      <Liebre size={120} pose="parada" />
    </g>
    <g transform="translate(560 668)">
      <Tortuga size={82} />
    </g>
    <g font-size="86" font-weight="500" fill="#2c2e2a">
      <circle cx="100" cy="230" r="44" fill="#ffffff"></circle>
      <text x="100" y="260" text-anchor="middle">
        ?
      </text>
    </g>
    <g transform="translate(470 150)">
      <circle cx="0" cy="0" r="40" fill="#ffffff"></circle>
      <path
        d="M-14 8 Q-24 -8 -10 -20 Q0 -30 12 -20 Q24 -8 14 8 Z"
        fill="#f5e211"
        stroke="#2c2e2a"
        stroke-width="4"
        stroke-linejoin="round"
      ></path>
      <path d="M-8 16 H8" stroke="#2c2e2a" stroke-width="5" stroke-linecap="round"></path>
    </g>
    <g font-size="30" font-weight="500" fill="#2c2e2a">
      <rect x="40" y="330" width="150" height="50" rx="25" fill="#ffffff"></rect>
      <text x="115" y="364" text-anchor="middle">
        predigo
      </text>
      <rect x="40" y="396" width="150" height="50" rx="25" fill="#ffffff"></rect>
      <text x="115" y="430" text-anchor="middle">
        pregunto
      </text>
      <rect x="40" y="462" width="150" height="50" rx="25" fill="#ffffff"></rect>
      <text x="115" y="496" text-anchor="middle">
        opino
      </text>
    </g>
  </svg>
</PortadaCapitulo>
