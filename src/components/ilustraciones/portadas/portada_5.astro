---
import PortadaCapitulo from '../../libro/portada_capitulo.astro';
import Sofia from '../sofia.astro';
import Tortuga from '../tortuga.astro';

interface Props {
  titulo: string;
  alt: string;
}
const { titulo, alt } = Astro.props;

const bloques = [
  { texto: 'opinión', color: '#ff705d', y: 610, w: 360 },
  { texto: 'razón', color: '#2ba0ff', y: 528, w: 330 },
  { texto: 'ejemplo', color: '#f5e211', y: 446, w: 300 },
  { texto: 'conclusión', color: '#e0dbce', y: 364, w: 270 },
];
---

<PortadaCapitulo numero={5} titulo={titulo} color="mixto" alt={alt}>
  <svg
    slot="fondo"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <g fill="#ffffff">
      <ellipse cx="170" cy="150" rx="88" ry="30"></ellipse>
      <ellipse cx="226" cy="126" rx="54" ry="34"></ellipse>
      <ellipse cx="600" cy="110" rx="76" ry="26"></ellipse>
    </g>
    <path d="M0 690 C220 650 520 670 800 640 V800 H0 Z" fill="#6fbb47"></path>
  </svg>
  <svg
    slot="medio"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <g transform="translate(540 0)">
      {bloques.map((b) => (
        <g>
          <rect
            x={-b.w / 2}
            y={b.y}
            width={b.w}
            height="72"
            rx="20"
            fill={b.color}
            stroke="#2c2e2a"
            stroke-width="5"
          ></rect>
          <text
            x="0"
            y={b.y + 47}
            text-anchor="middle"
            font-size="32"
            font-weight="500"
            fill="#2c2e2a"
          >
            {b.texto}
          </text>
        </g>
      ))}
      <path d="M0 364 V250" stroke="#2c2e2a" stroke-width="7" stroke-linecap="round"></path>
      <path
        d="M4 250 L84 274 L4 302 Z"
        fill="#ff705d"
        stroke="#2c2e2a"
        stroke-width="5"
        stroke-linejoin="round"
      ></path>
    </g>
  </svg>
  <svg
    slot="frente"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <g transform="translate(40 560)">
      <rect
        x="0"
        y="120"
        width="230"
        height="100"
        rx="18"
        fill="#ffffff"
        stroke="#2c2e2a"
        stroke-width="5"
      ></rect>
      <g transform="translate(60 -20)">
        <Sofia size={330} pose="senala" />
      </g>
    </g>
    <g transform="translate(620 690)">
      <Tortuga size={96} />
    </g>
  </svg>
</PortadaCapitulo>
