---
import PortadaCapitulo from '../../libro/portada_capitulo.astro';
import Sofia from '../sofia.astro';
import Mateo from '../mateo.astro';
import Libro from '../libro.astro';
import Periodico from '../periodico.astro';
import ListaPasos from '../lista_pasos.astro';
import Renacuajo from '../renacuajo.astro';

interface Props {
  titulo: string;
  alt: string;
}
const { titulo, alt } = Astro.props;
---

<PortadaCapitulo numero={2} titulo={titulo} color="sky-pop" alt={alt}>
  <svg
    slot="fondo"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <g fill="#ffffff">
      <ellipse cx="140" cy="140" rx="90" ry="30"></ellipse>
      <ellipse cx="196" cy="116" rx="54" ry="34"></ellipse>
      <ellipse cx="640" cy="230" rx="100" ry="32"></ellipse>
      <ellipse cx="690" cy="206" rx="56" ry="34"></ellipse>
    </g>
    <path d="M0 660 C200 600 460 620 800 590 V800 H0 Z" fill="#8ed462"></path>
  </svg>
  <svg
    slot="medio"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <path
      d="M382 800 C388 640 372 520 392 380 L430 380 C440 520 424 650 434 800 Z"
      fill="#8b6b4a"
    ></path>
    <path
      d="M410 470 C330 440 250 420 170 330"
      stroke="#8b6b4a"
      stroke-width="26"
      stroke-linecap="round"
      fill="none"
    ></path>
    <path
      d="M410 430 C500 400 580 390 650 300"
      stroke="#8b6b4a"
      stroke-width="26"
      stroke-linecap="round"
      fill="none"
    ></path>
    <path
      d="M410 380 C410 320 400 270 400 220"
      stroke="#8b6b4a"
      stroke-width="26"
      stroke-linecap="round"
      fill="none"
    ></path>
    <circle cx="410" cy="250" r="150" fill="#5aa03a"></circle>
    <circle cx="250" cy="330" r="110" fill="#6fbb47"></circle>
    <circle cx="590" cy="320" r="110" fill="#6fbb47"></circle>
    <circle cx="420" cy="180" r="100" fill="#8ed462"></circle>
  </svg>
  <svg
    slot="frente"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <g transform="translate(120 300)">
      <path d="M50 0 V40" stroke="#2c2e2a" stroke-width="5"></path>
      <rect x="-20" y="40" width="140" height="130" rx="22" fill="#ffffff"></rect>
      <g transform="translate(6 62)">
        <Libro size={86} />
      </g>
    </g>
    <g transform="translate(470 230)">
      <path d="M50 0 V40" stroke="#2c2e2a" stroke-width="5"></path>
      <rect x="-20" y="40" width="140" height="130" rx="22" fill="#ffffff"></rect>
      <g transform="translate(8 66)">
        <Periodico size={80} />
      </g>
    </g>
    <g transform="translate(300 90)">
      <path d="M50 0 V40" stroke="#2c2e2a" stroke-width="5"></path>
      <rect x="-20" y="40" width="140" height="130" rx="22" fill="#ffffff"></rect>
      <g transform="translate(14 60)">
        <ListaPasos size={98} />
      </g>
    </g>
    <g transform="translate(80 470)">
      <Mateo size={300} pose="libreta" />
    </g>
    <g transform="translate(500 470)">
      <Sofia size={300} pose="senala" />
    </g>
    <g transform="translate(330 640)">
      <Renacuajo size={130} />
    </g>
  </svg>
</PortadaCapitulo>
