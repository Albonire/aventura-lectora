---
import PortadaCapitulo from '../../libro/portada_capitulo.astro';
import Sofia from '../sofia.astro';
import Mateo from '../mateo.astro';
import Oruga from '../oruga.astro';
import Burbuja from '../burbuja.astro';

interface Props {
  titulo: string;
  alt: string;
}
const { titulo, alt } = Astro.props;
---

<PortadaCapitulo numero={2} titulo={titulo} color="sky-pop" alt={alt}>
  <svg
    slot="fondo"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <!-- Sol con rayos y sombra -->
    <g transform="translate(640, 140)">
      <circle cx="0" cy="0" r="94" fill="#facc15" opacity="0.3"></circle>
      <g stroke="#facc15" stroke-width="14" stroke-linecap="round">
        <line x1="0" y1="-105" x2="0" y2="-125" />
        <line x1="0" y1="105" x2="0" y2="125" />
        <line x1="-105" y1="0" x2="-125" y2="0" />
        <line x1="105" y1="0" x2="125" y2="0" />
        <line x1="-74" y1="-74" x2="-88" y2="-88" />
        <line x1="74" y1="74" x2="88" y2="88" />
        <line x1="-74" y1="74" x2="-88" y2="88" />
        <line x1="74" y1="-74" x2="88" y2="-88" />
      </g>
      <circle cx="0" cy="0" r="84" fill="#facc15"></circle>
      <path d="M -70 46 A 84 84 0 0 0 70 46 A 86 86 0 0 1 -70 46 Z" fill="#eab308"></path>
    </g>

    <!-- Nubes detalladas -->
    <g fill="#ffffff">
      <!-- Nube 1 -->
      <path d="M 90 190 A 34 34 0 0 1 110 130 A 48 48 0 0 1 200 120 A 40 40 0 0 1 260 160 A 30 30 0 0 1 240 210 L 90 210 A 30 30 0 0 1 90 190 Z"></path>
      <path d="M 90 210 L 240 210 A 30 30 0 0 0 258 185 C 230 195 190 200 160 195 C 130 190 110 180 90 170 A 30 30 0 0 0 90 210 Z" fill="#ece5d6" opacity="0.5"></path>
      
      <!-- Nube 2 -->
      <g transform="translate(280, -60) scale(0.7)">
        <path d="M 90 190 A 34 34 0 0 1 110 130 A 48 48 0 0 1 200 120 A 40 40 0 0 1 260 160 A 30 30 0 0 1 240 210 L 90 210 A 30 30 0 0 1 90 190 Z"></path>
        <path d="M 90 210 L 240 210 A 30 30 0 0 0 258 185 C 230 195 190 200 160 195 C 130 190 110 180 90 170 A 30 30 0 0 0 90 210 Z" fill="#ece5d6" opacity="0.5"></path>
      </g>
    </g>

    <!-- Colina verde de fondo -->
    <path
      d="M0 610 C180 520 360 540 560 470 C660 436 740 440 800 456 V800 H0 Z"
      fill="#65a30d"
    ></path>
    <!-- Detalle de la colina (sombra/relieve) -->
    <path
      d="M0 650 C180 560 360 580 560 510 C660 476 740 480 800 496 V800 H0 Z"
      fill="#5aa03a"
      opacity="0.3"
    ></path>
  </svg>
  <svg
    slot="medio"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <!-- sugar cane -->
    <g stroke="#4d7c0f" stroke-width="12" stroke-linecap="round" fill="none">
      <path d="M690 640 V380 M730 650 V420 M650 650 V440"></path>
    </g>
    <g stroke="#84cc16" stroke-width="10" stroke-linecap="round" fill="none">
      <path d="M690 400 Q650 370 620 380 M690 430 Q730 400 760 410 M730 440 Q770 420 790 440 M650 460 Q610 440 590 460"></path>
    </g>
    <!-- trapiche roof -->
    <path d="M40 520 L170 430 L300 520 Z" fill="#f43f5e" stroke="#1e293b" stroke-width="6" stroke-linejoin="round"></path>
    <rect x="70" y="520" width="14" height="130" fill="#8b6b4a" stroke="#1e293b" stroke-width="4"></rect>
    <rect x="256" y="520" width="14" height="130" fill="#8b6b4a" stroke="#1e293b" stroke-width="4"></rect>
  </svg>
  <svg
    slot="frente"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <Burbuja x={250} y={150} ancho={330} tamano={36} texto="Cuéntame, abuelo" cola_x={0.3} />
    <g transform="translate(130 400)">
      <Sofia size={350} pose="cadera" />
    </g>
    <g transform="translate(400 420)">
      <Mateo size={330} pose="libreta" />
    </g>
    <g transform="translate(650 690)">
      <Oruga size={90} />
    </g>
  </svg>
</PortadaCapitulo>
