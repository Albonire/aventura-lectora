---
// mission 3: Mateo checks two messages of the family phone with the caterpillar of the top hat
import PortadaCapitulo from '../../libro/portada_capitulo.astro';
import EscenaBase from '../escena_base.astro';
import Plantas from '../plantas.astro';
import Mateo from '../mateo.astro';
import Oruga from '../oruga.astro';
import Pieza from '../pieza.astro';
import { TINTA } from '../../../lib/arte/paleta';
import { MARCAS_VERDAD } from '../../../lib/arte/piezas/escena';
import Celular from '../celular.astro';

interface Props {
  titulo: string;
  alt: string;
}
const { titulo, alt } = Astro.props;

---

<PortadaCapitulo numero={3} titulo={titulo} color="sunshine-pop" alt={alt}>
  <svg viewBox="0 0 560 440" class="block h-auto w-full" focusable="false" aria-hidden="true">
    <EscenaBase sol={false} />
    <g class="pintado">
    <Plantas tipo="hojas" x={6} y={282} escala={1.15} />
    <Plantas tipo="flor" x={110} y={352} escala={0.5} color="coral" />
    <Plantas tipo="pasto" x={500} y={350} escala={0.56} />
    <!-- the phone, bigger than life, with its two messages -->
    <g transform="translate(372 96) rotate(8 80 130)">
      <Celular size={270} />
    </g>
    </g>
    <Pieza formas={MARCAS_VERDAD} escala={1.4} />
    <text x="536" y="306" text-anchor="middle" font-size="40" font-weight="700" fill={TINTA}>?</text>
    <g class="pintado">
    <g transform="translate(104 74)">
      <Mateo size={340} pose="libreta" />
    </g>
    <g transform="translate(40 318)">
      <Oruga size={92} />
    </g>
    </g>
  </svg>
</PortadaCapitulo>
