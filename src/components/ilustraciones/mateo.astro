---
// Mateo, "el Rastreador de Pistas": the shapes live in src/lib/arte/piezas/mateo.ts.
// Hand painted storybook look (see src/lib/arte). Inside another svg, size is in user units.
import Pieza from './pieza.astro';
import { MATEO, MATEO_ALTO, MATEO_ANCHO } from '../../lib/arte/piezas/mateo';
import type { Detalle } from '../../lib/arte/capas';

interface Props {
  // height in px
  size?: number;
  // "libreta": writes in the field notebook. "levanta": raises an arm and keeps the notebook under the other.
  pose?: 'libreta' | 'levanta';
  // small drawings (under 110 px) drop the fine details by themselves
  detalle?: Detalle;
  class?: string;
}
const { size = 220, pose = 'libreta', detalle, class: clase = '' } = Astro.props;
const nivel = detalle ?? (size < 110 ? 'reducido' : 'completo');
---

<svg
  viewBox={`0 0 ${MATEO_ANCHO} ${MATEO_ALTO}`}
  height={size}
  width={(size * MATEO_ANCHO) / MATEO_ALTO}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <Pieza formas={MATEO[pose]} detalle={nivel} escala={0.9} />
</svg>
