---
// clipboard with numbered steps
interface Props {
  size?: number;
  class?: string;
}
const { size = 80, class: clase = '' } = Astro.props;
---

<svg
  viewBox="0 0 84 96"
  height={size}
  width={(size * 84) / 96}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <rect
    x="8"
    y="10"
    width="68"
    height="82"
    rx="8"
    fill="#e0dbce"
    stroke="#2c2e2a"
    stroke-width="3"
  ></rect>
  <rect x="16" y="20" width="52" height="66" rx="4" fill="#ffffff"></rect>
  <rect
    x="28"
    y="4"
    width="28"
    height="14"
    rx="5"
    fill="#8ed462"
    stroke="#2c2e2a"
    stroke-width="3"
  ></rect>
  <g font-size="12" font-weight="500" fill="#2c2e2a">
    <text x="21" y="38">
      1
    </text>
    <text x="21" y="55">
      2
    </text>
    <text x="21" y="72">
      3
    </text>
  </g>
  <path
    d="M34 34 H60 M34 51 H60 M34 68 H52"
    stroke="#d5d5d4"
    stroke-width="3.5"
    stroke-linecap="round"
  ></path>
  <path
    d="M55 64 L59 69 L67 59"
    stroke="#2c2e2a"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  ></path>
</svg>
