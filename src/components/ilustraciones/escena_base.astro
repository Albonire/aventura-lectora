---
// base of every storybook scene: sun, clouds, two hills and the patch of ground where the characters stand.
// Drawn for a 560 x 440 view box. The background plane has no outline and light tones, so the
// characters (ink outline) stand out in front. Shapes in src/lib/arte/piezas/escena.ts.
import Pieza from './pieza.astro';
import { fondo } from '../../lib/arte/piezas/escena';

interface Props {
  sol?: boolean;
  nubes?: boolean;
  loma?: boolean;
}
const { sol = true, nubes = true, loma = true } = Astro.props;
---

<Pieza formas={fondo({ sol, nubes, loma })} escala={1.4} />
