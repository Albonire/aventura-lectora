---
// speech bubble drawn in svg units: white with the ink outline, a small tail and a hard offset shadow toward
// the bottom right (the light comes from the top left), no blur.
// The text is wrapped by hand because svg has no automatic line breaks.
import { TINTA } from '../../lib/arte/paleta';

interface Props {
  x: number;
  y: number;
  ancho?: number;
  texto: string;
  tamano?: number;
  // side of the tail and its horizontal position along the bubble
  cola?: 'abajo' | 'arriba';
  cola_x?: number;
  fondo?: string;
}
const {
  x,
  y,
  ancho = 200,
  texto,
  tamano = 15,
  cola = 'abajo',
  cola_x = 0.5,
  fondo = 'white',
} = Astro.props;

function partir(t: string, max: number): string[] {
  const salida: string[] = [];
  let actual = '';
  for (const palabra of t.split(' ')) {
    if ((actual + ' ' + palabra).trim().length > max && actual) {
      salida.push(actual);
      actual = palabra;
    } else {
      actual = (actual + ' ' + palabra).trim();
    }
  }
  if (actual) salida.push(actual);
  return salida;
}

const interlineado = tamano * 1.28;
const max_chars = Math.floor((ancho - 30) / (tamano * 0.55));
const lineas = partir(texto, max_chars);
const alto = lineas.length * interlineado + 26;
const cx = x + ancho * cola_x;
---

<g>
  <rect x={x + 3} y={y + 3} width={ancho} height={alto} rx="20" fill={TINTA} opacity="0.16"></rect>
  <rect x={x} y={y} width={ancho} height={alto} rx="20" fill={fondo} stroke={TINTA} stroke-width="4"></rect>
  {
    cola === 'abajo' ? (
      <path
        d={`M${cx - 14} ${y + alto - 2} L${cx - 4} ${y + alto + 24} L${cx + 16} ${y + alto - 2}`}
        fill={fondo}
        stroke={TINTA}
        stroke-width="4"
        stroke-linejoin="round"
        stroke-linecap="round"
      />
    ) : (
      <path
        d={`M${cx - 14} ${y + 2} L${cx - 4} ${y - 24} L${cx + 16} ${y + 2}`}
        fill={fondo}
        stroke={TINTA}
        stroke-width="4"
        stroke-linejoin="round"
        stroke-linecap="round"
      />
    )
  }
  <!-- hides the outline of the bubble where the tail starts -->
  <rect x={cx - 12} y={cola === 'abajo' ? y + alto - 6 : y + 2} width="26" height="5" fill={fondo}></rect>
  <text x={x + 16} y={y + 12 + tamano} font-size={tamano} font-weight="700" fill={TINTA}>
    {lineas.map((l, i) => (
      <tspan x={x + 16} dy={i === 0 ? 0 : interlineado}>
        {l}
      </tspan>
    ))}
  </text>
</g>
