---
// family phone with two messages: one that can be trusted (blue, has an author) and one chain message (coral).
// Shapes in src/lib/arte/piezas/objetos.ts.
import Pieza from './pieza.astro';
import { CELULAR, CELULAR_ALTO, CELULAR_ANCHO } from '../../lib/arte/piezas/objetos';

interface Props {
  size?: number;
  class?: string;
}
const { size = 100, class: clase = '' } = Astro.props;
---

<svg
  viewBox={`0 0 ${CELULAR_ANCHO} ${CELULAR_ALTO}`}
  height={size}
  width={(size * CELULAR_ANCHO) / CELULAR_ALTO}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <Pieza formas={CELULAR} detalle={size < 90 ? 'reducido' : 'completo'} escala={0.35} />
</svg>
