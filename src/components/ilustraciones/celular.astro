---
// family phone with two messages: one that can be trusted (check mark) and one rumor (question mark)
interface Props {
  size?: number;
  class?: string;
}
const { size = 100, class: clase = '' } = Astro.props;
const TINTA = '#1e293b';
---

<svg
  viewBox="0 0 96 156"
  height={size}
  width={(size * 96) / 156}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <g stroke={TINTA} stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round">
    <rect x="6" y="4" width="84" height="148" rx="14" fill="#334155"></rect>
    <rect x="14" y="20" width="68" height="112" rx="5" fill="#ffffff" stroke-width="3"></rect>
    <path d="M40 12 H56" fill="none" stroke="#94a3b8"></path>
    <circle cx="48" cy="142" r="4" fill="#94a3b8" stroke="none"></circle>
    <!-- message with an author -->
    <path d="M20 30 H62 C66 30 68 32 68 36 V54 C68 58 66 60 62 60 H30 L20 68 Z" fill="#bae6fd" stroke-width="3"></path>
    <path d="M28 40 H58 M28 49 H50" fill="none" stroke="#0369a1" stroke-width="3"></path>
    <!-- rumor -->
    <path d="M76 78 H34 C30 78 28 80 28 84 V102 C28 106 30 108 34 108 H66 L76 116 Z" fill="#fda4af" stroke-width="3"></path>
    <path d="M36 88 H66 M36 97 H56" fill="none" stroke="#be123c" stroke-width="3"></path>
  </g>
</svg>
