---
// phone showing message bubbles
interface Props {
  size?: number;
  class?: string;
}
const { size = 100, class: clase = '' } = Astro.props;
---

<svg
  viewBox="0 0 64 104"
  height={size}
  width={(size * 64) / 104}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <rect x="4" y="4" width="56" height="96" rx="10" fill="#2c2e2a"></rect>
  <rect x="9" y="14" width="46" height="76" rx="4" fill="#ffffff"></rect>
  <rect x="14" y="20" width="30" height="14" rx="5" fill="#2ba0ff"></rect>
  <rect x="20" y="40" width="30" height="14" rx="5" fill="#f5e211"></rect>
  <rect x="14" y="60" width="26" height="14" rx="5" fill="#ff705d"></rect>
  <circle cx="32" cy="96" r="2" fill="#5f615e"></circle>
</svg>
