---
// open book with a coral cover, white pages and a sky blue bookmark. Shapes in src/lib/arte/piezas/objetos.ts.
import Pieza from './pieza.astro';
import { LIBRO, LIBRO_ALTO, LIBRO_ANCHO } from '../../lib/arte/piezas/objetos';

interface Props {
  size?: number;
  class?: string;
}
const { size = 80, class: clase = '' } = Astro.props;
---

<svg
  viewBox={`0 0 ${LIBRO_ANCHO} ${LIBRO_ALTO}`}
  height={size}
  width={(size * LIBRO_ANCHO) / LIBRO_ALTO}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <Pieza formas={LIBRO} detalle={size < 70 ? 'reducido' : 'completo'} escala={0.4} />
</svg>
