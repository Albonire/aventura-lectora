---
// open book with a coral cover, white pages and a sky blue bookmark
interface Props {
  size?: number;
  class?: string;
}
const { size = 80, class: clase = '' } = Astro.props;
const TINTA = '#1e293b';
---

<svg
  viewBox="0 0 120 88"
  height={size}
  width={(size * 120) / 88}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <g stroke={TINTA} stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round">
    <!-- cover -->
    <path d="M4 76 V22 Q34 12 60 26 Q86 12 116 22 V76 Q86 66 60 80 Q34 66 4 76 Z" fill="#f43f5e"></path>
    <!-- pages -->
    <path d="M12 68 V16 Q38 8 60 22 Q82 8 108 16 V68 Q82 60 60 74 Q38 60 12 68 Z" fill="#ffffff"></path>
    <path d="M60 22 V74" fill="none"></path>
    <!-- bookmark -->
    <path d="M78 12 V38 L85 32 L92 38 V13 Z" fill="#0284c7" stroke-width="3"></path>
    <!-- lines of text -->
    <path
      d="M22 28 Q36 24 50 31 M22 39 Q36 35 50 42 M22 50 Q36 46 50 53 M70 42 Q84 35 98 39 M70 53 Q84 46 98 50"
      fill="none"
      stroke="#cbd5e1"
      stroke-width="3.5"></path>
  </g>
</svg>
