---
// symbol of the club: the sky blue magnifying glass of Sofía. Shapes in src/lib/arte/piezas/objetos.ts.
import Pieza from './pieza.astro';
import { LUPA_LADO, LUPA_SIMBOLO } from '../../lib/arte/piezas/objetos';

interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: clase = '' } = Astro.props;
---

<svg
  viewBox={`0 0 ${LUPA_LADO} ${LUPA_LADO}`}
  width={size}
  height={size}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <Pieza formas={LUPA_SIMBOLO} detalle={size < 60 ? 'reducido' : 'completo'} escala={0.25} />
</svg>
