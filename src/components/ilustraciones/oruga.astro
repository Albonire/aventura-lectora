---
// the reading caterpillar: green body, black top hat and red bow tie (companion of Mateo in mission 3)
interface Props {
  size?: number;
  class?: string;
}
const { size = 80, class: clase = '' } = Astro.props;
const TINTA = '#1e293b';
const segmentos: [number, number, number][] = [
  [26, 74, 13],
  [46, 70, 14],
  [66, 74, 14],
  [86, 70, 15],
];
---

<svg
  viewBox="0 0 150 104"
  height={size}
  width={(size * 150) / 104}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <!-- little feet -->
  <g stroke={TINTA} stroke-width="3" stroke-linecap="round">
    <path d="M24 86 L22 94 M46 84 L45 93 M66 87 L66 95 M86 85 L88 93"></path>
  </g>
  <!-- body -->
  {segmentos.map(([x, y, r], i) => (
    <circle cx={x} cy={y} r={r} fill={i % 2 === 0 ? '#84cc16' : '#65a30d'} stroke={TINTA} stroke-width="2.5" />
  ))}
  <!-- head -->
  <circle cx="110" cy="56" r="20" fill="#84cc16" stroke={TINTA} stroke-width="2.5"></circle>
  <circle cx="104" cy="54" r="3" fill={TINTA}></circle>
  <circle cx="118" cy="54" r="3" fill={TINTA}></circle>
  <circle cx="99" cy="62" r="3.5" fill="#f43f5e" opacity="0.4"></circle>
  <circle cx="123" cy="62" r="3.5" fill="#f43f5e" opacity="0.4"></circle>
  <path d="M105 63 Q111 69 117 63" stroke={TINTA} stroke-width="2.5" stroke-linecap="round" fill="none"></path>
  <!-- red bow tie -->
  <path d="M98 78 L88 72 L89 86 Z" fill="#f43f5e" stroke={TINTA} stroke-width="2" stroke-linejoin="round"></path>
  <path d="M98 78 L108 73 L107 87 Z" fill="#f43f5e" stroke={TINTA} stroke-width="2" stroke-linejoin="round"></path>
  <circle cx="98" cy="79" r="3" fill="#e11d48" stroke={TINTA} stroke-width="1.5"></circle>
  <!-- black top hat -->
  <rect x="92" y="36" width="36" height="6" rx="3" fill={TINTA}></rect>
  <rect x="98" y="12" width="24" height="26" rx="2" fill={TINTA}></rect>
  <rect x="98" y="30" width="24" height="5" fill="#f43f5e"></rect>
</svg>
