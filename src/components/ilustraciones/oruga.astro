---
// the reading caterpillar: green body, black top hat and red bow tie (companion of Mateo in missions 2 and 3).
// The shapes live in src/lib/arte/piezas/animales.ts.
import Pieza from './pieza.astro';
import { ORUGA, ORUGA_ANCHO, ORUGA_ALTO } from '../../lib/arte/piezas/animales';
import type { Detalle } from '../../lib/arte/capas';

interface Props {
  // height in px
  size?: number;
  // small drawings (under 70 px) drop the fine details by themselves
  detalle?: Detalle;
  class?: string;
}
const { size = 80, detalle, class: clase = '' } = Astro.props;
const nivel = detalle ?? (size < 70 ? 'reducido' : 'completo');
---

<svg
  viewBox={`0 0 ${ORUGA_ANCHO} ${ORUGA_ALTO}`}
  height={size}
  width={(size * ORUGA_ANCHO) / ORUGA_ALTO}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <Pieza formas={ORUGA} detalle={nivel} escala={0.55} />
</svg>
