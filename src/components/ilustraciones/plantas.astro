---
// plants of the storybook scenes, in a 100 x 100 box with the ground at y = 100. Middle plane: thin outline
// of their own dark tone. Shapes in src/lib/arte/piezas/escena.ts.
import Pieza from './pieza.astro';
import { FLORES, PLANTAS } from '../../lib/arte/piezas/escena';

interface Props {
  tipo: 'mata' | 'hojas' | 'pasto' | 'flor' | 'cana' | 'cacao';
  x?: number;
  y?: number;
  // scale of the 100 x 100 box
  escala?: number;
  // petals of the flower
  color?: 'coral' | 'amarillo' | 'violeta';
  espejo?: boolean;
}
const { tipo, x = 0, y = 0, escala = 1, color = 'coral', espejo = false } = Astro.props;
const formas = tipo === 'flor' ? FLORES[color] : PLANTAS[tipo];
const giro = espejo ? ' translate(100 0) scale(-1 1)' : '';
---

<g transform={`translate(${x} ${y}) scale(${escala})${giro}`}>
  <Pieza formas={formas} detalle={escala < 0.5 ? 'reducido' : 'completo'} escala={0.4} />
</g>
