---
// plants of the storybook scenes: soft shapes without outline, as in figure 2 of guide 2.1.
// Drawn in a 100 x 100 box with the ground at y = 100.
interface Props {
  tipo: 'mata' | 'hojas' | 'pasto' | 'flor';
  x?: number;
  y?: number;
  // scale of the 100 x 100 box
  escala?: number;
  // petal color of the flower
  color?: string;
  espejo?: boolean;
}
const { tipo, x = 0, y = 0, escala = 1, color = '#f43f5e', espejo = false } = Astro.props;
const SALVIA = '#7cb46b';
const HOJA = '#9ccf6a';
const OSCURO = '#5a9a4e';
const giro = espejo ? ` translate(100 0) scale(-1 1)` : '';
---

<g transform={`translate(${x} ${y}) scale(${escala})${giro}`}>
  {
    tipo === 'mata' && (
      <>
        <path d="M50 100 C30 96 14 76 20 52 C40 58 52 78 50 100 Z" fill={SALVIA} />
        <path d="M50 100 C46 70 56 44 78 34 C86 60 74 88 50 100 Z" fill={HOJA} />
        <path d="M50 100 C54 84 68 72 88 72 C86 90 70 100 50 100 Z" fill={OSCURO} />
        <path d="M50 100 C44 88 30 82 14 86 C20 98 34 102 50 100 Z" fill={HOJA} />
      </>
    )
  }
  {
    tipo === 'hojas' && (
      <>
        <path d="M46 100 C22 84 14 52 30 22 C54 42 60 76 46 100 Z" fill={SALVIA} />
        <path d="M34 34 C38 56 42 78 46 100" fill="none" stroke={OSCURO} stroke-width="3" stroke-linecap="round" />
        <path d="M54 100 C56 78 72 62 94 60 C92 82 76 98 54 100 Z" fill={HOJA} />
        <path d="M88 66 C74 76 62 88 54 100" fill="none" stroke={SALVIA} stroke-width="3" stroke-linecap="round" />
      </>
    )
  }
  {
    tipo === 'pasto' && (
      <path
        d="M30 100 C32 84 30 72 24 62 C36 70 40 84 40 100 M44 100 C44 78 48 62 56 50 C58 68 56 84 54 100 M60 100 C62 86 68 76 78 70 C76 82 72 92 70 100"
        fill={SALVIA}
        stroke={SALVIA}
        stroke-width="4"
        stroke-linejoin="round"
      />
    )
  }
  {
    tipo === 'flor' && (
      <>
        <path d="M50 100 C50 84 50 70 50 56" fill="none" stroke={OSCURO} stroke-width="4" stroke-linecap="round" />
        <path d="M50 84 C40 82 34 74 34 66 C44 68 50 74 50 84 Z" fill={SALVIA} />
        <g fill={color}>
          <circle cx="50" cy="34" r="9" />
          <circle cx="36" cy="46" r="9" />
          <circle cx="64" cy="46" r="9" />
          <circle cx="42" cy="60" r="9" />
          <circle cx="58" cy="60" r="9" />
        </g>
        <circle cx="50" cy="48" r="7" fill="#facc15" />
      </>
    )
  }
</g>
