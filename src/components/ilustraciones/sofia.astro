---
// Sofía, "la Guardiana de la Lupa" (character sheet of guide 2.1, figure 2): 10 years old, light brown skin,
// brown hair in a high ponytail with a red bow, yellow jacket with two buttons, dark blue pants and a sky blue
// magnifying glass. Flat storybook vector: big head, one outline color, no gradients.
// The head group is repeated in src/components/islas/personajes.tsx (CaraSofia): change both together.
interface Props {
  // height in px (inside another svg: in user units)
  size?: number;
  // "lupa": looks through the magnifying glass. "senala": points up and keeps the glass down.
  pose?: 'lupa' | 'senala';
  class?: string;
}
const { size = 220, pose = 'lupa', class: clase = '' } = Astro.props;
const TINTA = '#1e293b';
const PIEL = '#d9a273';
const PELO = '#6b3f26';
const PELO_LUZ = '#855233';
const CHAQUETA = '#facc15';
const CHAQUETA_LUZ = '#fde047';
const PANTALON = '#1e3a8a';
const VIDRIO = '#bae6fd';
const AZUL = '#0284c7';
---

<svg
  viewBox="0 0 264 314"
  height={size}
  width={(size * 264) / 314}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <g stroke={TINTA} stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
    <!-- ponytail, behind the head -->
    <path
      d="M94 52 C82 22 44 22 40 54 C14 68 10 106 30 130 C18 148 28 172 52 174 C42 162 48 150 58 144 C76 132 78 108 66 94 C62 76 72 60 94 52 Z"
      fill={PELO}></path>
    <path d="M42 62 C30 86 34 110 48 124" fill="none" stroke={PELO_LUZ} stroke-width="5"></path>

    <!-- legs and shoes -->
    <path d="M94 238 L94 294 L122 294 L124 238 Z" fill={PANTALON}></path>
    <path d="M128 238 L130 294 L158 294 L156 238 Z" fill={PANTALON}></path>
    <path d="M90 292 H124 C132 292 136 298 136 306 H86 C84 300 86 294 90 292 Z" fill="#0f172a"></path>
    <path d="M128 292 H162 C170 292 174 298 174 306 H124 C122 300 124 294 128 292 Z" fill="#0f172a"></path>

    <!-- neck -->
    <path d="M114 144 V166 H138 V144 Z" fill={PIEL}></path>

    <!-- jacket -->
    <path
      d="M100 160 C84 164 76 188 76 242 L170 242 C170 198 166 170 152 160 C140 168 112 168 100 160 Z"
      fill={CHAQUETA}></path>
    <path d="M126 178 V242" fill="none" stroke-width="3"></path>
    <path d="M104 160 L126 178 L112 190 L97 166 Z" fill={CHAQUETA_LUZ}></path>
    <path d="M148 160 L126 178 L140 190 L155 166 Z" fill={CHAQUETA_LUZ}></path>
    <!-- two buttons -->
    <circle cx="136" cy="200" r="4.5" fill="#ffffff" stroke-width="3"></circle>
    <circle cx="136" cy="220" r="4.5" fill="#ffffff" stroke-width="3"></circle>
    <path d="M86 218 H104" fill="none" stroke-width="3"></path>

    <!-- head -->
    <path
      d="M66 100 C66 60 96 42 126 42 C158 42 182 64 182 100 C182 134 156 154 126 154 C92 154 66 134 66 100 Z"
      fill={PIEL}></path>
    <!-- hair with a side fringe -->
    <path
      d="M64 110 C54 66 84 32 126 34 C164 36 190 64 184 100 C178 84 166 72 150 68 C134 86 106 96 82 96 C74 99 68 104 64 110 Z"
      fill={PELO}></path>
    <path d="M150 68 C142 62 132 58 120 58" fill="none" stroke={PELO_LUZ} stroke-width="4"></path>
    <!-- red bow that ties the ponytail -->
    <path d="M88 46 L70 34 C66 44 68 54 74 60 Z" fill="#f43f5e"></path>
    <path d="M88 46 L98 26 C108 30 112 38 110 48 Z" fill="#f43f5e"></path>
    <circle cx="89" cy="46" r="6.5" fill="#e11d48"></circle>
    <!-- ear -->
    <path d="M72 98 C60 96 56 112 64 120 C68 124 74 122 76 118 Z" fill={PIEL}></path>

    <!-- face -->
    <g stroke="none">
      <ellipse cx="108" cy="124" rx="10" ry="7" fill="#fb7185" opacity="0.5"></ellipse>
      <ellipse cx="172" cy="120" rx="8" ry="6.5" fill="#fb7185" opacity="0.5"></ellipse>
      <ellipse cx="128" cy="108" rx="5" ry="7" fill={TINTA}></ellipse>
      <ellipse cx="162" cy="106" rx="5" ry="7" fill={TINTA}></ellipse>
      <circle cx="129.8" cy="105" r="1.9" fill="#ffffff"></circle>
      <circle cx="163.8" cy="103" r="1.9" fill="#ffffff"></circle>
    </g>
    <g fill="none" stroke-width="3.5">
      <path d="M118 93 Q127 87 136 92"></path>
      <path d="M154 90 Q162 85 170 90"></path>
      <path d="M148 112 q6 5 0 10" stroke-width="3"></path>
      <path d="M132 130 Q146 141 160 128"></path>
    </g>

    {
      pose === 'senala' ? (
        <>
          <!-- left hand keeps the magnifying glass down -->
          <path d="M70 250 L56 274" fill="none" stroke-width="13"></path>
          <path d="M70 250 L56 274" fill="none" stroke="#0369a1" stroke-width="6"></path>
          <circle cx="48" cy="286" r="19" fill={AZUL}></circle>
          <circle cx="48" cy="286" r="12.5" fill={VIDRIO} stroke-width="3"></circle>
          <path d="M98 164 C80 170 70 198 68 226 L88 230 C90 208 96 192 104 182 Z" fill={CHAQUETA}></path>
          <circle cx="76" cy="238" r="11" fill={PIEL}></circle>
          <!-- right arm points up -->
          <path
            d="M148 164 C172 160 196 140 210 118 L228 132 C212 160 182 186 146 190 Z"
            fill={CHAQUETA}></path>
          <path d="M226 116 L238 100" fill="none" stroke-width="12"></path>
          <path d="M226 116 L238 100" fill="none" stroke={PIEL} stroke-width="5"></path>
          <circle cx="222" cy="122" r="11" fill={PIEL}></circle>
        </>
      ) : (
        <>
          <!-- relaxed arm -->
          <path d="M98 164 C80 170 70 198 68 226 L88 230 C90 208 96 192 104 182 Z" fill={CHAQUETA}></path>
          <circle cx="76" cy="238" r="11" fill={PIEL}></circle>
          <!-- arm that holds the sky blue magnifying glass -->
          <path
            d="M148 164 C168 166 186 178 204 178 L206 200 C184 204 162 198 146 188 Z"
            fill={CHAQUETA}></path>
          <path d="M214 184 L222 152" fill="none" stroke-width="13"></path>
          <path d="M214 184 L222 152" fill="none" stroke="#0369a1" stroke-width="6"></path>
          <circle cx="226" cy="118" r="30" fill={AZUL}></circle>
          <circle cx="226" cy="118" r="21" fill={VIDRIO} stroke-width="3"></circle>
          <path d="M213 112 A15 15 0 0 1 224 103" fill="none" stroke="#ffffff" stroke-width="4.5"></path>
          <circle cx="212" cy="190" r="11.5" fill={PIEL}></circle>
        </>
      )
    }
  </g>
</svg>
