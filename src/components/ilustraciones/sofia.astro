---
// Sofía, "la Guardiana de la Lupa": the shapes live in src/lib/arte/piezas/sofia.ts.
// Hand painted storybook look (see src/lib/arte). Inside another svg, size is in user units.
import Pieza from './pieza.astro';
import { SOFIA, SOFIA_ALTO, SOFIA_ANCHO } from '../../lib/arte/piezas/sofia';
import type { Detalle } from '../../lib/arte/capas';

interface Props {
  // height in px
  size?: number;
  // "lupa": looks through the magnifying glass. "senala": points up and keeps the glass down.
  pose?: 'lupa' | 'senala';
  // small drawings (under 110 px) drop the fine details by themselves
  detalle?: Detalle;
  class?: string;
}
const { size = 220, pose = 'lupa', detalle, class: clase = '' } = Astro.props;
const nivel = detalle ?? (size < 110 ? 'reducido' : 'completo');
---

<svg
  viewBox={`0 0 ${SOFIA_ANCHO} ${SOFIA_ALTO}`}
  height={size}
  width={(size * SOFIA_ANCHO) / SOFIA_ALTO}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <Pieza formas={SOFIA[pose]} detalle={nivel} escala={0.9} />
</svg>
