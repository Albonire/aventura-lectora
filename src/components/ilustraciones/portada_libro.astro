---
// art of the book cover: the crayon drawing of the two detectives beside a big open book, with the animals of the
// fables. It is an image (two sizes), not an svg: the cover turns in 3D, so it never gets the pen filter.
// The drawing made with code is kept in portada_libro_vectorial.astro.
// Decorative: the title and the buttons of the cover already say everything.
import chica from '../../assets/ilustraciones/tapa_portada_480.webp';
import grande from '../../assets/ilustraciones/tapa_portada_900.webp';
---

<img
  src={grande.src}
  srcset={`${chica.src} ${chica.width}w, ${grande.src} ${grande.width}w`}
  sizes="(min-width: 768px) 560px, 90vw"
  width={grande.width}
  height={grande.height}
  alt=""
  aria-hidden="true"
  decoding="async"
  fetchpriority="high"
  class="mx-auto block h-full max-h-full w-auto max-w-full rounded-soft border-2 border-ink-black object-contain"
/>
