---
// art of the book cover: the two detectives beside a big open book, with the animals of the fables
import EscenaBase from './escena_base.astro';
import Plantas from './plantas.astro';
import Sofia from './sofia.astro';
import Mateo from './mateo.astro';
import Conejo from './conejo.astro';
import Tortuga from './tortuga.astro';
import Oruga from './oruga.astro';
import Libro from './libro.astro';
---

<svg
  viewBox="0 0 560 440"
  class="mx-auto block h-full max-h-full w-auto max-w-full"
  aria-hidden="true"
  focusable="false"
>
  <!-- cream plate, so the lime sweater and the plants stand out on the green cover -->
  <rect x="4" y="52" width="552" height="384" rx="30" fill="#faf6ee" stroke="#1e293b" stroke-width="4"></rect>
  <EscenaBase nubes={false} sol={false} loma={false} />
  <Plantas tipo="hojas" x={0} y={296} escala={1.05} />
  <Plantas tipo="mata" x={468} y={306} escala={0.95} espejo />
  <Plantas tipo="flor" x={236} y={356} escala={0.46} color="#f43f5e" />
  <Plantas tipo="flor" x={300} y={362} escala={0.4} color="#facc15" />
  <g transform="translate(176 232)">
    <Libro size={150} />
  </g>
  <g transform="translate(222 150)">
    <Conejo size={112} />
  </g>
  <g transform="translate(300 208)">
    <Tortuga size={56} />
  </g>
  <g transform="translate(250 352)">
    <Oruga size={58} />
  </g>
  <g transform="translate(-6 96)">
    <Sofia size={312} pose="lupa" />
  </g>
  <g transform="translate(338 96)">
    <Mateo size={312} pose="libreta" />
  </g>
</svg>
