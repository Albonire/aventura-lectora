---
// the rabbit of the fables: sand color, long ears and a red scarf (companion of Sofía in mission 1).
// The shapes live in src/lib/arte/piezas/animales.ts.
import Pieza from './pieza.astro';
import { CONEJO, CONEJO_ANCHO, CONEJO_ALTO } from '../../lib/arte/piezas/animales';
import type { Detalle } from '../../lib/arte/capas';

interface Props {
  // height in px
  size?: number;
  // small drawings (under 70 px) drop the fine details by themselves
  detalle?: Detalle;
  class?: string;
}
const { size = 110, detalle, class: clase = '' } = Astro.props;
const nivel = detalle ?? (size < 70 ? 'reducido' : 'completo');
---

<svg
  viewBox={`0 0 ${CONEJO_ANCHO} ${CONEJO_ALTO}`}
  height={size}
  width={(size * CONEJO_ANCHO) / CONEJO_ALTO}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <Pieza formas={CONEJO} detalle={nivel} escala={0.55} />
</svg>
