---
// the tortoise of the fables: lime body and dark shell with lighter plates (companion of Sofía in mission 1).
// The shapes live in src/lib/arte/piezas/animales.ts.
import Pieza from './pieza.astro';
import { TORTUGA, TORTUGA_ANCHO, TORTUGA_ALTO } from '../../lib/arte/piezas/animales';
import type { Detalle } from '../../lib/arte/capas';

interface Props {
  // height in px
  size?: number;
  // small drawings (under 70 px) drop the fine details by themselves
  detalle?: Detalle;
  class?: string;
}
const { size = 80, detalle, class: clase = '' } = Astro.props;
const nivel = detalle ?? (size < 70 ? 'reducido' : 'completo');
---

<svg
  viewBox={`0 0 ${TORTUGA_ANCHO} ${TORTUGA_ALTO}`}
  height={size}
  width={(size * TORTUGA_ANCHO) / TORTUGA_ALTO}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <Pieza formas={TORTUGA} detalle={nivel} escala={0.55} />
</svg>
