---
// the tortoise: green shell with hexagons and yellow dots
interface Props {
  size?: number;
  class?: string;
}
const { size = 80, class: clase = '' } = Astro.props;
const hex = (cx: number, cy: number, r: number) =>
  Array.from({ length: 6 }, (_, i) => {
    const a = (Math.PI / 3) * i + Math.PI / 6;
    return `${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`;
  }).join(' ');
const centros: [number, number][] = [
  [48, 52],
  [68, 44],
  [88, 52],
  [58, 64],
  [78, 64],
];
---

<svg
  viewBox="0 0 146 92"
  height={size}
  width={(size * 146) / 92}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <path d="M10 74 L22 68 L22 78 Z" fill="#8ed462"></path>
  <rect x="34" y="70" width="16" height="16" rx="6" fill="#8ed462"></rect>
  <rect x="86" y="70" width="16" height="16" rx="6" fill="#8ed462"></rect>
  <rect x="106" y="60" width="14" height="12" fill="#8ed462"></rect>
  <circle cx="126" cy="58" r="14" fill="#8ed462"></circle>
  <circle cx="131" cy="55" r="2.5" fill="#2c2e2a"></circle>
  <path
    d="M126 64 Q131 68 136 64"
    stroke="#2c2e2a"
    stroke-width="2"
    stroke-linecap="round"
    fill="none"
  ></path>
  <path d="M20 72 C20 26 108 26 112 72 Z" fill="#4f9a34"></path>
  {centros.map(([x, y]) => (
    <polygon points={hex(x, y, 10)} fill="#8ed462"></polygon>
  ))}
  {centros.map(([x, y]) => (
    <circle cx={x} cy={y} r="2.8" fill="#f5e211"></circle>
  ))}
  <rect x="18" y="70" width="96" height="8" rx="4" fill="#e0dbce"></rect>
</svg>
