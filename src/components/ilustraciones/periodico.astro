---
// folded newspaper
interface Props {
  size?: number;
  class?: string;
}
const { size = 80, class: clase = '' } = Astro.props;
---

<svg
  viewBox="0 0 100 88"
  height={size}
  width={(size * 100) / 88}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <rect
    x="14"
    y="10"
    width="78"
    height="68"
    rx="6"
    fill="#e0dbce"
    stroke="#2c2e2a"
    stroke-width="3"
  ></rect>
  <rect
    x="8"
    y="16"
    width="78"
    height="68"
    rx="6"
    fill="#ffffff"
    stroke="#2c2e2a"
    stroke-width="3"
  ></rect>
  <rect x="16" y="24" width="62" height="10" rx="3" fill="#2c2e2a"></rect>
  <rect x="16" y="40" width="26" height="22" rx="3" fill="#2ba0ff"></rect>
  <path
    d="M48 42 H76 M48 50 H76 M48 58 H70 M16 68 H76 M16 75 H62"
    stroke="#d5d5d4"
    stroke-width="3"
    stroke-linecap="round"
  ></path>
</svg>
