---
// a short reading (150 to 250 words) with numbered paragraphs and short stops of the guide.
// It is plain text: nothing is hidden and nothing depends on scripts. The numbers let Sofía's hints
// say exactly which paragraph to read again.
import { ReadAloud } from '../islas/read_aloud';
import { Burbuja } from '../islas/personajes';
import BloqueCabecera from '../ui/bloque_cabecera.astro';

interface Parrafo {
  texto: string;
  // part of the story ("Inicio", "Nudo", "Desenlace"), only for teachers reading the data
  parte?: string;
  pausa?: { estrategia?: string; texto: string };
}
interface Props {
  id: string;
  titulo: string;
  autoria?: string;
  parrafos: Parrafo[];
  moraleja?: string;
  quien?: 'sofia' | 'mateo';
}
const { id, titulo, autoria, parrafos, moraleja, quien = 'sofia' } = Astro.props;
const texto_completo = [
  titulo,
  ...parrafos.map((p) => p.texto),
  moraleja ? `Moraleja: ${moraleja}` : '',
]
  .filter(Boolean)
  .join('. ');
const palabras = parrafos.reduce((n, p) => n + p.texto.trim().split(/\s+/).length, 0);
---

<article
  id={id}
  data-lectura
  data-palabras={palabras}
  class="scroll-mt-28 rounded-card border-2 border-ink-black bg-pure-white p-5 text-ink-black md:p-8"
>
  <BloqueCabecera tipo="lee" etiqueta={autoria} titulo={titulo} />
  <ReadAloud client:idle texto={texto_completo} />

  <ol class="mx-auto mt-6 flex max-w-reading flex-col gap-6">
    {
      parrafos.map((p, i) => (
        <li>
          <p class="interfaz mb-1 text-micro font-medium text-stone-text">Párrafo {i + 1}</p>
          <p class="text-reading">{p.texto}</p>
          {p.pausa && (
            <Burbuja quien={quien} tono="pista" className="mt-4">
              {p.pausa.estrategia && (
                <span class="interfaz mr-2 inline-block rounded-pill border-2 border-ink-black bg-pure-white px-3 py-0.5 text-body-sm font-bold">
                  {p.pausa.estrategia}
                </span>
              )}
              <span>{p.pausa.texto}</span>
            </Burbuja>
          )}
        </li>
      ))
    }
    {
      moraleja && (
        <li class="rounded-soft border-2 border-ink-black bg-cream-paper p-4">
          <p class="interfaz text-body-sm font-medium text-stone-text">Moraleja</p>
          <p class="mt-1 text-reading font-bold">{moraleja}</p>
        </li>
      )
    }
  </ol>
</article>
