---
// the Truth Detector of Mateo: three questions to ask before believing or sharing a message
import { ShieldCheck } from '@phosphor-icons/react/ssr';

interface Props {
  preguntas: { id: string; pregunta: string; detalle: string }[];
}
const { preguntas } = Astro.props;
---

<section
  aria-labelledby="detector-titulo"
  class="rounded-card border-2 border-ink-black bg-pure-white p-5 md:p-8"
>
  <h3 id="detector-titulo" class="flex items-center gap-3 text-[1.375rem] leading-snug">
    <span
      class="flex size-11 shrink-0 items-center justify-center rounded-full border-2 border-ink-black bg-fresh-grass"
      aria-hidden="true"
    >
      <ShieldCheck size={26} weight="bold" />
    </span>
    El Detector de Verdades
  </h3>
  <p class="mt-2 text-body">Antes de creer o compartir un mensaje, hazle estas tres preguntas.</p>
  <ol class="mt-4 grid gap-3 md:grid-cols-3">
    {
      preguntas.map((p, i) => (
        <li class="rounded-soft border-2 border-ink-black bg-cream-paper p-4">
          <p class="text-body font-bold">
            {i + 1}. {p.pregunta}
          </p>
          <p class="mt-1 text-body">{p.detalle}</p>
        </li>
      ))
    }
  </ol>
</section>
