---
// chapter opening of a case: big number, title and an illustration in three paper layers
import { CaretDown } from '@phosphor-icons/react/ssr';

interface Props {
  numero: number;
  titulo: string;
  color: 'fresh-grass' | 'sky-pop' | 'sunshine-pop' | 'coral-pop' | 'mixto';
  alt: string;
}
const { numero, titulo, color, alt } = Astro.props;

const fondos: Record<Props['color'], string> = {
  'fresh-grass': 'bg-fresh-grass',
  'sky-pop': 'bg-sky-pop',
  'sunshine-pop': 'bg-sunshine-pop',
  'coral-pop': 'bg-coral-pop',
  mixto: 'bg-fresh-grass',
};
const numero_texto = String(numero).padStart(2, '0');
---

<section
  id="portada"
  aria-labelledby="portada-titulo"
  data-capitulo
  class:list={[
    'relative isolate flex min-h-[100svh] items-end overflow-hidden text-ink-black',
    fondos[color],
  ]}
>
  {color === 'mixto' && (
    <div class="absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-sunshine-pop" aria-hidden="true"></div>
  )}

  <div
    class="absolute inset-x-0 top-0 h-[60%] md:inset-y-0 md:left-auto md:right-0 md:h-full md:w-[60%]"
    role="img"
    aria-label={alt}
  >
    <div data-capa="0" class="absolute inset-0" aria-hidden="true">
      <slot name="fondo" />
    </div>
    <div data-capa="1" class="absolute inset-0" aria-hidden="true">
      <slot name="medio" />
    </div>
    <div data-capa="2" class="absolute inset-0" aria-hidden="true">
      <slot name="frente" />
    </div>
  </div>

  <div class="contenedor relative z-10 pb-16 pt-32 md:pb-24">
    <p class="text-body font-medium">Caso {numero}</p>
    <p
      data-numero
      aria-hidden="true"
      class="-ml-1 mt-1 text-display-lg font-medium leading-[0.9] tracking-tighter"
    >
      {numero_texto}
    </p>
    <h1
      id="portada-titulo"
      class="mt-3 max-w-[14ch] text-[clamp(2.4rem,0.8rem+4.4vw,4.4rem)] font-medium leading-none tracking-tighter md:max-w-[10ch] lg:max-w-[12ch]"
    >
      {titulo}
    </h1>
    <p class="mt-8 flex items-center gap-2 text-body-sm font-medium" data-indicio>
      <CaretDown size={18} weight="bold" aria-hidden="true" />
      Sigue bajando para abrir el caso
    </p>
  </div>
</section>

<script>
  import '../../lib/scroll/capitulo';
</script>
