---
// opening of a station: its code, name and an illustrated scene.
// The scene sits in a cream picture frame, like the plates of a storybook (guide 2.1, figure 2).
import { estacion_de_caso, folio, pagina_por_slug } from '../../config/paginas';

interface Props {
  numero: number;
  titulo: string;
  color: 'fresh-grass' | 'sky-pop' | 'sunshine-pop' | 'coral-pop';
  alt: string;
}
const { numero, titulo, color, alt } = Astro.props;

// the title is written over the fill, so blue and coral use their soft version
const fondos: Record<Props['color'], string> = {
  'fresh-grass': 'bg-fresh-grass',
  'sky-pop': 'bg-sky-soft',
  'sunshine-pop': 'bg-sunshine-pop',
  'coral-pop': 'bg-coral-soft',
};
const estacion = estacion_de_caso(numero);
const primera = pagina_por_slug('abrir');
---

<section id="portada" aria-labelledby="portada-titulo" class="contenedor pt-6 md:pt-10">
  <div
    class:list={[
      'grid overflow-hidden rounded-soft border-2 border-ink-black text-ink-black md:grid-cols-2',
      fondos[color],
    ]}
  >
    <div class="p-3 pb-0 md:order-last md:p-4 md:pl-0">
      <div
        class="overflow-hidden rounded-soft border-2 border-ink-black bg-cream-paper papel"
        role="img"
        aria-label={alt}
      >
        <slot />
      </div>
    </div>

    <div class="flex flex-col justify-end p-5 md:p-8">
      <p class="interfaz text-body font-bold">{estacion.etiqueta}</p>
      <p
        aria-hidden="true"
        class="-ml-0.5 mt-1 text-[clamp(3.5rem,2rem+7vw,6rem)] leading-[0.9] font-medium tracking-tighter"
      >
        {estacion.codigo}
      </p>
      <h1 id="portada-titulo" class="mt-3 max-w-[16ch] text-heading leading-tight">
        {titulo}
      </h1>
      <p class="interfaz mt-4 text-body-sm font-medium">
        {primera?.titulo} · {folio('abrir')}
      </p>
    </div>
  </div>
</section>
