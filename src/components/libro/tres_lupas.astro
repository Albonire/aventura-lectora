---
// three nested lenses: literal, inferential and critical. Stacked cards without scripts.
interface Lupa {
  id: string;
  titulo: string;
  descripcion: string;
  preguntas: string;
}
interface Props {
  lupas: Lupa[];
}
const { lupas } = Astro.props;
const tonos = ['bg-sunshine-pop/40', 'bg-sunshine-pop/70', 'bg-sunshine-pop'];
const aros = ['#fdf3c8', '#f9e979', '#f5e211'];
---

<div data-lupas class="lupas">
  <div data-escenario class="lupas-escenario">
    <ol class="lupas-lista">
      {lupas.map((l, i) => (
        <li id={l.id} data-lente={i + 1} class="lupas-lente scroll-mt-28">
          <svg class="lupas-aro" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
            <path d="M78 78 L108 108" stroke="#2c2e2a" stroke-width="9" stroke-linecap="round" />
            <circle cx="50" cy="50" r="42" fill={aros[i]} stroke="#2c2e2a" stroke-width="4" />
          </svg>
          <div class:list={['rounded-card p-7 text-ink-black md:p-10', tonos[i % tonos.length]]}>
            <div class="flex items-center gap-5">
              <svg
                viewBox="0 0 80 80"
                width={56 + i * 12}
                height={56 + i * 12}
                aria-hidden="true"
                focusable="false"
                class="shrink-0"
              >
                <path d="M50 50 L72 72" stroke="#2c2e2a" stroke-width="9" stroke-linecap="round" />
                <circle cx="34" cy="34" r="26" fill="#f5f1e4" stroke="#2c2e2a" stroke-width="6" />
                {i > 0 && (
                  <circle cx="34" cy="34" r="15" fill="#f5e211" stroke="#2c2e2a" stroke-width="4" />
                )}
                {i > 1 && (
                  <circle cx="34" cy="34" r="6" fill="#ffffff" stroke="#2c2e2a" stroke-width="3" />
                )}
              </svg>
              <h4 class="text-heading-sm font-medium leading-tight tracking-tight">{l.titulo}</h4>
            </div>
            <p class="mt-5 text-reading">{l.descripcion}</p>
            <p class="mt-3 text-body">{l.preguntas}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  .lupas-lista {
    display: grid;
    gap: 1.5rem;
  }
  :global(.lupas-activo) .lupas-escenario {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
  }
  :global(.lupas-activo) .lupas-lista {
    position: absolute;
    inset: 0;
    display: block;
  }
  :global(.lupas-activo) .lupas-lente {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 1.25rem;
  }
  :global(.lupas-activo) .lupas-lente > div {
    position: relative;
    z-index: 1;
    width: min(28rem, 52vmin);
  }
  .lupas-aro {
    display: none;
  }
  :global(.lupas-activo) .lupas-aro {
    --tam: min(92vmin, 60rem);
    display: block;
    position: absolute;
    z-index: 0;
    width: var(--tam);
    height: var(--tam);
    left: calc(50% - var(--tam) * 0.4167);
    top: calc(50% - var(--tam) * 0.4167);
  }
  :global(.lupas-activo) .lupas-lente > div p {
    font-size: var(--text-body);
  }
</style>

<script>
  import '../../lib/scroll/lupas';
</script>
