---
// short instructive text: a farm recipe with its ingredients and numbered steps
import { ReadAloud } from '../islas/read_aloud';
import BloqueCabecera from '../ui/bloque_cabecera.astro';

interface Props {
  id: string;
  titulo: string;
  autoria?: string;
  entrada: string;
  ingredientes: string[];
  pasos: { id: string; texto: string }[];
}
const { id, titulo, autoria, entrada, ingredientes, pasos } = Astro.props;
const texto_voz = [
  titulo,
  entrada,
  `Ingredientes: ${ingredientes.join(', ')}`,
  `Pasos. ${pasos.map((p, i) => `Paso ${i + 1}: ${p.texto}`).join(' ')}`,
].join('. ');
---

<article
  id={id}
  data-lectura
  class="scroll-mt-28 rounded-card border-2 border-ink-black bg-pure-white p-5 text-ink-black md:p-8"
>
  <BloqueCabecera tipo="lee" etiqueta={autoria} titulo={titulo} />
  <ReadAloud client:idle texto={texto_voz} />

  <div class="mx-auto mt-6 max-w-reading">
    <p class="text-reading">{entrada}</p>

    <h4 class="mt-6 text-subheading font-bold">Ingredientes</h4>
    <ul class="mt-2 list-disc space-y-1 pl-6 text-reading">
      {ingredientes.map((i) => <li>{i}</li>)}
    </ul>

    <h4 class="mt-6 text-subheading font-bold">Pasos</h4>
    <ol class="mt-3 flex flex-col gap-3">
      {
        pasos.map((p, i) => (
          <li class="flex items-start gap-3">
            <span
              class="interfaz flex size-9 shrink-0 items-center justify-center rounded-full border-2 border-ink-black bg-sunshine-pop text-body-sm font-bold"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <p class="pt-0.5 text-reading">
              <span class="sr-only">Paso {i + 1}: </span>
              {p.texto}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</article>
