---
// subsection of the development part: a titled block with a stable id
interface Props {
  id: string;
  titulo: string;
  etiqueta?: string;
}
const { id, titulo, etiqueta } = Astro.props;
---

<div
  id={id}
  class="scroll-mt-28 border-t-2 border-ink-black pt-10 first:border-t-0 first:pt-0 [&:not(:first-child)]:mt-20"
>
  {etiqueta && <p class="text-body-sm font-medium text-stone-text">{etiqueta}</p>}
  <h3 class="mt-1 max-w-3xl text-heading font-medium leading-tight tracking-tight">{titulo}</h3>
  <div class="mt-8 flex flex-col gap-8">
    <slot />
  </div>
</div>
