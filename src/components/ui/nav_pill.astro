---
import { getCollection } from 'astro:content';
import { List, X } from '@phosphor-icons/react/ssr';
import Lupa from '../ilustraciones/lupa.astro';
import { sitio } from '../../config/sitio';

const unidades = (await getCollection('unidades')).sort((a, b) => a.data.numero - b.data.numero);
const ruta_actual = Astro.url.pathname.replace(/\/$/, '') || '/';

const enlaces_docentes = [
  { href: '/ficha', texto: 'Ficha de diseño' },
  { href: '/docentes', texto: 'Para docentes' },
  { href: '/referencias', texto: 'Referencias' },
];

const color_caso: Record<string, string> = {
  'fresh-grass': 'bg-fresh-grass',
  'sky-pop': 'bg-sky-pop',
  'sunshine-pop': 'bg-sunshine-pop',
  'coral-pop': 'bg-coral-pop',
  mixto: 'bg-fresh-grass',
};
---

<header
  data-nav
  class="pointer-events-none fixed inset-x-0 top-3 z-50 flex justify-center px-3 md:top-4"
>
  <nav
    aria-label="Principal"
    class="pointer-events-auto relative flex w-full max-w-[62rem] items-center justify-between gap-2 rounded-pill bg-pure-white py-1.5 pr-1.5 pl-4 md:pl-5"
  >
    <a
      href="/"
      class="flex min-h-11 items-center gap-2 text-body-sm font-medium tracking-tight text-ink-black"
      aria-current={ruta_actual === '/' ? 'page' : undefined}
    >
      <Lupa size={26} />
      <span>{sitio.nombre_curso}</span>
    </a>

    <ol class="hidden items-center gap-1 lg:flex" aria-label="Casos">
      {unidades.map((u) => (
        <li>
          <a
            href={`/unidad/${u.data.numero}`}
            data-caso={u.data.numero}
            aria-current={ruta_actual === `/unidad/${u.data.numero}` ? 'page' : undefined}
            aria-label={`Caso ${u.data.numero}: ${u.data.titulo}`}
            class="caso-chip group relative flex size-11 items-center justify-center rounded-full text-body-sm font-medium text-ink-black hover:bg-cream-paper aria-[current=page]:bg-ink-black aria-[current=page]:text-cream-paper"
          >
            <span aria-hidden="true">0{u.data.numero}</span>
            <span
              class="estado-punto pointer-events-none absolute right-1 top-1 hidden size-3.5 items-center justify-center rounded-full border-2 border-ink-black bg-pure-white"
              aria-hidden="true"
            />
            <span class="estado-texto sr-only" />
          </a>
        </li>
      ))}
    </ol>

    <div class="flex items-center gap-1.5">
      <a
        href="/"
        data-seguir
        hidden
        class="seguir min-h-11 items-center gap-3 rounded-pill bg-cream-paper px-4 text-body-sm font-medium text-ink-black hover:bg-sandstone"
      >
        Seguir donde iba
        <span
          class="size-2.5 rounded-full border-2 border-ink-black bg-coral-pop"
          aria-hidden="true"
        ></span>
      </a>

      <details data-menu class="group">
        <summary
          class="flex size-11 list-none items-center justify-center rounded-full bg-fresh-grass text-ink-black [&::-webkit-details-marker]:hidden"
          aria-label="Menú"
        >
          <span class="group-open:hidden" aria-hidden="true">
            <List size={22} weight="bold" />
          </span>
          <span class="hidden group-open:inline" aria-hidden="true">
            <X size={22} weight="bold" />
          </span>
        </summary>

        <div class="absolute right-0 top-full mt-2 max-h-[calc(100dvh-6rem)] w-[min(94vw,27rem)] overflow-y-auto rounded-card bg-pure-white p-6 md:p-8">
          <p class="text-body-sm font-medium text-stone-text">Los casos</p>
          <ol class="mt-3 flex flex-col gap-1">
            {unidades.map((u) => (
              <li>
                <a
                  href={`/unidad/${u.data.numero}`}
                  data-caso={u.data.numero}
                  aria-current={ruta_actual === `/unidad/${u.data.numero}` ? 'page' : undefined}
                  class="flex min-h-12 items-center gap-3 rounded-soft px-2 py-1.5 text-body-sm text-ink-black hover:bg-cream-paper aria-[current=page]:bg-cream-paper"
                >
                  <span
                    class:list={[
                      'flex size-9 shrink-0 items-center justify-center rounded-full font-medium',
                      color_caso[u.data.color],
                    ]}
                    aria-hidden="true"
                  >
                    0{u.data.numero}
                  </span>
                  <span class="flex-1">
                    <span class="sr-only">Caso {u.data.numero}: </span>
                    {u.data.titulo}
                  </span>
                  <span class="estado-etiqueta inline-flex items-center gap-1 text-micro text-stone-text" />
                </a>
              </li>
            ))}
          </ol>

          <p class="mt-6 text-body-sm font-medium text-stone-text">Cierre del curso</p>
          <ul class="mt-2">
            <li>
              <a
                href="/cierre"
                class="flex min-h-11 items-center rounded-soft px-2 text-body-sm text-ink-black hover:bg-cream-paper"
                aria-current={ruta_actual === '/cierre' ? 'page' : undefined}
              >
                Expediente y certificado
              </a>
            </li>
          </ul>

          <p class="mt-6 text-body-sm font-medium text-stone-text">Para docentes</p>
          <ul class="mt-2">
            {enlaces_docentes.map((e) => (
              <li>
                <a
                  href={e.href}
                  class="flex min-h-11 items-center rounded-soft px-2 text-body-sm text-ink-black hover:bg-cream-paper"
                  aria-current={ruta_actual === e.href ? 'page' : undefined}
                >
                  {e.texto}
                </a>
              </li>
            ))}
          </ul>

          <div data-ajustes class="mt-6 hidden border-t border-hairline-mist pt-5 [.js_&]:block">
            <p class="text-body-sm font-medium text-stone-text">Cómo quieres leer</p>
            <ul class="mt-3 flex flex-col gap-2">
              <li>
                <button
                  type="button"
                  role="switch"
                  aria-checked="true"
                  data-ajuste="movimiento"
                  class="interruptor"
                >
                  <span>Movimiento</span>
                  <span class="interruptor-pista" aria-hidden="true">
                    <span class="interruptor-bola"></span>
                  </span>
                </button>
              </li>
              <li>
                <button
                  type="button"
                  role="switch"
                  aria-checked="false"
                  data-ajuste="letra_grande"
                  class="interruptor"
                >
                  <span>Letra grande</span>
                  <span class="interruptor-pista" aria-hidden="true">
                    <span class="interruptor-bola"></span>
                  </span>
                </button>
              </li>
              <li>
                <button
                  type="button"
                  role="switch"
                  aria-checked="false"
                  data-ajuste="voz"
                  class="interruptor"
                >
                  <span>Leer en voz alta</span>
                  <span class="interruptor-pista" aria-hidden="true">
                    <span class="interruptor-bola"></span>
                  </span>
                </button>
              </li>
            </ul>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  .seguir {
    display: none;
  }
  @media (min-width: 640px) {
    .seguir:not([hidden]) {
      display: inline-flex;
    }
  }
  .interruptor {
    display: flex;
    width: 100%;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-radius: var(--radius-soft);
    padding: 0.25rem 0.5rem;
    font-size: var(--text-body-sm);
    color: var(--color-ink-black);
    text-align: left;
  }
  .interruptor:hover {
    background: var(--color-cream-paper);
  }
  .interruptor-pista {
    position: relative;
    display: inline-block;
    width: 3rem;
    height: 1.75rem;
    flex-shrink: 0;
    border: 2px solid var(--color-ink-black);
    border-radius: 9999px;
    background: var(--color-pure-white);
  }
  .interruptor-bola {
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 9999px;
    background: var(--color-ink-black);
    translate: 0 -50%;
    transition: left 160ms ease-out;
  }
  .interruptor[aria-checked='true'] .interruptor-pista {
    background: var(--color-fresh-grass);
  }
  .interruptor[aria-checked='true'] .interruptor-bola {
    left: calc(100% - 1.05rem - 0.2rem);
  }
  .interruptor[aria-checked='true'] span:first-child::after {
    content: ': sí';
  }
  .interruptor[aria-checked='false'] span:first-child::after {
    content: ': no';
  }
  /* state indicators filled by the global script */
  .caso-chip[data-estado='en_curso'] .estado-punto,
  .caso-chip[data-estado='resuelto'] .estado-punto {
    display: flex;
  }
  .caso-chip[data-estado='en_curso'] .estado-punto {
    background: var(--color-sunshine-pop);
  }
  .caso-chip[data-estado='resuelto'] .estado-punto {
    background: var(--color-fresh-grass);
  }
  .caso-chip[data-estado='resuelto'] .estado-punto::after {
    content: '';
    width: 0.35rem;
    height: 0.2rem;
    margin-top: -0.1rem;
    border-left: 2px solid var(--color-ink-black);
    border-bottom: 2px solid var(--color-ink-black);
    rotate: -45deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .interruptor-bola {
      transition: none;
    }
  }
</style>
