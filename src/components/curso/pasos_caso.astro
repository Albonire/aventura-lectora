---
// the fixed sequence of four steps of every mission, as pill buttons under the title:
// "1. Abrir el caso", "2. Seguir las pistas", "3. Entrenar la lupa", "4. Cerrar el caso".
// It never changes, so the students with less practice on screens always know where they are.
import { paginas_caso, ruta_pagina, id_pagina, type SlugPagina } from '../../config/paginas';

interface Props {
  caso: number;
  actual: SlugPagina;
}
const { caso, actual } = Astro.props;
---

<nav aria-label="Pasos de este caso" class="contenedor mt-3 mb-2" data-pasos-caso>
  <ol class="grid grid-cols-2 gap-2 sm:grid-cols-4">
    {
      paginas_caso.map((p, i) => (
        <li>
          <a
            href={ruta_pagina(caso, p.slug)}
            data-pagina={id_pagina(caso, p.slug)}
            aria-current={p.slug === actual ? 'page' : undefined}
            class="paso interfaz flex min-h-12 items-center justify-center rounded-pill border-2 border-ink-black bg-pure-white px-3 py-1.5 text-center text-body-sm font-medium leading-tight hover:bg-sandstone aria-[current=page]:bg-ink-black aria-[current=page]:text-cream-paper"
          >
            <span>
              {i + 1}. {p.titulo}
              <span class="estado-pagina block text-micro font-normal" />
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .paso[data-leida='true']:not([aria-current='page']) {
    background: var(--color-fresh-grass);
  }
  .paso[data-leida='true']:not([aria-current='page']):hover {
    background: var(--color-ink-black);
    color: var(--color-cream-paper);
  }
  .estado-pagina:empty {
    display: none;
  }
</style>
