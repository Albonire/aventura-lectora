---
// end of a page: previous and next page in the reading order, plus the folio ("Página 2 de 4")
import type { Destino } from '../../config/paginas';

interface Props {
  anterior: Destino | null;
  siguiente: Destino | null;
  folio?: string;
  // key of the page, remembered as read when this block scrolls into view
  pagina_id?: string;
  // last page of a case: the next link is the "turn the page" action
  pasar?: boolean;
}
const { anterior, siguiente, folio, pagina_id, pasar = false } = Astro.props;
---

<nav
  aria-label="Páginas del libro"
  data-fin-pagina={pagina_id}
  class="contenedor mt-6 mb-10 border-t-2 border-ink-black pt-8 md:mb-14"
>
  <div class="grid gap-4 sm:grid-cols-2">
    {anterior ? (
      <a
        href={anterior.href}
        rel="prev"
        class="pagina-enlace flex flex-col justify-center rounded-soft border-2 border-ink-black bg-pure-white p-5 hover:bg-sandstone"
      >
        <span class="text-body-sm font-medium text-stone-text">Página anterior</span>
        <span class="mt-1 text-subheading font-medium">{anterior.titulo}</span>
        <span class="mt-1 text-body-sm text-stone-text">{anterior.contexto}</span>
      </a>
    ) : (
      <span class="hidden sm:block"></span>
    )}
    {siguiente && (
      <a
        href={siguiente.href}
        rel="next"
        data-pasar-pagina={pasar ? '' : undefined}
        class="pagina-enlace flex flex-col justify-center rounded-soft border-2 border-ink-black bg-fresh-grass p-5 text-ink-black hover:bg-ink-black hover:text-cream-paper sm:text-right"
      >
        <span class="text-body-sm font-medium">
          {pasar ? 'Pasar la página' : 'Página siguiente'}
        </span>
        <span class="mt-1 text-subheading font-medium">{siguiente.titulo}</span>
        <span class="mt-1 text-body-sm">{siguiente.contexto}</span>
      </a>
    )}
  </div>
  {folio && <p class="mt-6 text-center text-body-sm text-stone-text">{folio}</p>}
</nav>
