---
// the route of the adventure: six stations. Beside the page on wide screens, inside the menu on small ones.
// The current mission is open with its four steps; states ("Leída", "En curso") are written by the global script.
import { estaciones, paginas_caso, id_pagina, ruta_pagina, type Ubicacion } from '../../config/paginas';

interface Props {
  variante: 'lateral' | 'menu';
  ubicacion?: Ubicacion;
}
const { variante, ubicacion } = Astro.props;

const caso_actual = ubicacion?.tipo === 'caso' ? ubicacion.caso : undefined;
const pagina_actual = ubicacion?.tipo === 'caso' ? ubicacion.pagina : undefined;

const discos = ['bg-sandstone', 'bg-fresh-grass', 'bg-sky-soft', 'bg-sunshine-pop', 'bg-coral-soft', 'bg-sandstone'];
const etiqueta = variante === 'lateral' ? 'El camino de la aventura' : 'El camino de la aventura en el menú';
---

<nav aria-label={etiqueta} data-indice={variante}>
  <ol class="flex flex-col gap-1">
    {
      estaciones.map((e, i) =>
        e.caso ? (
          <li>
            <details class="grupo" open={e.caso === caso_actual} data-caso={e.caso}>
              <summary class="enlace resumen">
                <span class:list={['disco', discos[i]]} aria-hidden="true">
                  {e.codigo}
                </span>
                <span class="flex-1">
                  <span class="block text-micro text-stone-text">{e.etiqueta}</span>
                  {e.titulo}
                </span>
                <span class="estado-etiqueta text-micro text-stone-text" />
              </summary>
              <ol class="paginas">
                {paginas_caso.map((p, n) => {
                  const es_actual = e.caso === caso_actual && p.slug === pagina_actual;
                  return (
                    <li>
                      <a
                        href={ruta_pagina(e.caso as number, p.slug)}
                        class="enlace pagina"
                        data-pagina={id_pagina(e.caso as number, p.slug)}
                        aria-current={es_actual ? 'page' : undefined}
                      >
                        <span class="flex-1">
                          {n + 1}. {p.titulo}
                        </span>
                        <span class="estado-pagina text-micro" />
                      </a>
                    </li>
                  );
                })}
              </ol>
            </details>
          </li>
        ) : (
          <li>
            <a
              href={e.href}
              class="enlace"
              aria-current={
                (e.href === '/agencia' && ubicacion?.tipo === 'agencia') ||
                (e.href === '/cierre' && ubicacion?.tipo === 'cierre')
                  ? 'page'
                  : undefined
              }
            >
              <span class:list={['disco', discos[i]]} aria-hidden="true">
                {e.codigo}
              </span>
              <span class="flex-1">
                <span class="etiqueta-estacion block text-micro">{e.etiqueta}</span>
                {e.titulo}
              </span>
            </a>
          </li>
        ),
      )
    }
  </ol>
</nav>

<style>
  .enlace {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.75rem;
    border-radius: var(--radius-soft);
    padding: 0.25rem 0.75rem;
    font-size: var(--text-body-sm);
    line-height: 1.3;
    color: var(--color-ink-black);
  }
  .enlace:hover {
    background: var(--color-cream-paper);
  }
  .enlace[aria-current='page'] {
    background: var(--color-ink-black);
    color: var(--color-cream-paper);
  }
  .etiqueta-estacion {
    color: var(--color-stone-text);
  }
  .enlace[aria-current='page'] .etiqueta-estacion {
    color: inherit;
  }
  .resumen {
    cursor: pointer;
    list-style: none;
    font-weight: var(--font-weight-medium);
  }
  .resumen::-webkit-details-marker {
    display: none;
  }
  .resumen::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: 45deg;
    transition: rotate 160ms ease-out;
  }
  .grupo[open] > .resumen::after {
    rotate: -135deg;
  }
  .disco {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-ink-black);
    border-radius: 9999px;
    font-size: var(--text-micro);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink-black);
  }
  .paginas {
    margin: 0.25rem 0 0.5rem 1.1rem;
    border-left: 2px solid var(--color-hairline-mist);
    padding-left: 0.5rem;
  }
  .pagina {
    font-weight: var(--font-weight-regular);
  }
  .estado-pagina:empty,
  .estado-etiqueta:empty {
    display: none;
  }
  .pagina[data-leida='true'] .estado-pagina::before {
    content: '';
    display: inline-block;
    width: 0.55rem;
    height: 0.3rem;
    margin-right: 0.35rem;
    border-left: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: -45deg;
    translate: 0 -0.15rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .resumen::after {
      transition: none;
    }
  }
</style>
