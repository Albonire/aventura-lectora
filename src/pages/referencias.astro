---
import CursoLayout from '../layouts/curso_layout.astro';
import EncabezadoPagina from '../components/curso/encabezado_pagina.astro';
import Seccion from '../components/ui/seccion.astro';
import ButtonGhost from '../components/ui/button_ghost.astro';
import Apa from '../components/ui/apa.astro';
import { referencias } from '../data/referencias';
import { autoras, sitio } from '../config/sitio';

// only the references that were opened and matched their citation are published
const quitar_tildes = (t: string) =>
  Array.from(t.normalize('NFD'))
    .filter((c) => c.charCodeAt(0) < 0x300 || c.charCodeAt(0) > 0x36f)
    .join('');
const plano = (t: string) => quitar_tildes(t.replace(/\*/g, '')).toLowerCase();
const ordenadas = referencias
  .filter((r) => r.verificado)
  .sort((a, b) => plano(a.apa).localeCompare(plano(b.apa), 'es'));

const herramientas = [
  ['Astro', 'Framework del sitio', 'MIT'],
  ['React', 'Actividades interactivas', 'MIT'],
  ['GSAP y ScrollTrigger', 'Apertura del libro de la portada', 'Licencia estándar de GSAP, gratuita'],
  ['Tailwind CSS', 'Estilos', 'MIT'],
  ['Inter (Rasmus Andersson)', 'Tipografía de la interfaz, autoalojada', 'SIL Open Font License 1.1'],
  [
    'Andika (SIL International)',
    'Tipografía de las lecturas, autoalojada',
    'SIL Open Font License 1.1',
  ],
  ['Phosphor Icons', 'Iconos', 'MIT'],
  ['dnd kit', 'Arrastrar y soltar accesible', 'MIT'],
  ['jsPDF', 'Descarga del certificado en PDF', 'MIT'],
  ['Web Speech API del navegador', 'Botón "Escuchar con voz pausada"', 'Función del navegador'],
];
---

<CursoLayout
  titulo="Referencias y créditos"
  descripcion="Referencias en formato APA 7 y créditos de Aventura lectora."
  titulo_cabecera="Referencias y créditos"
  sin_paginador
>
  <EncabezadoPagina etiqueta="Para docentes" titulo="Referencias y créditos" color="coral-pop">
    <p>Formato APA 7.ª edición. Solo aparecen las fuentes que se abrieron y se revisaron.</p>
  </EncabezadoPagina>

  <Seccion id="lista" titulo="Lista de referencias" etiqueta="APA 7">
    <ul class="max-w-4xl space-y-5">
      {
        ordenadas.map((r) => (
          <li class="ref text-body">
            <Apa texto={r.apa} />
          </li>
        ))
      }
    </ul>
  </Seccion>

  <Seccion id="creditos" titulo="Créditos" etiqueta="Quién hizo qué">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-soft border-2 border-ink-black bg-pure-white p-5">
        <h3 class="text-subheading font-medium">Docentes autoras</h3>
        <ul class="mt-3 space-y-1 text-body">
          {autoras.map((a) => <li>{a}</li>)}
        </ul>
        <p class="mt-3 text-body-sm text-stone-text">
          {sitio.institucion} ({sitio.sector.toLowerCase()}), {sitio.municipio}. {sitio.poblacion}.
        </p>
      </div>
      <div class="rounded-soft border-2 border-ink-black bg-pure-white p-5">
        <h3 class="text-subheading font-medium">Datos académicos</h3>
        <p class="mt-3 text-body">
          {sitio.universidad}, {sitio.sede}. {sitio.programa} ({sitio.anio}).
        </p>
        <p class="mt-2 text-body">Espacio académico: {sitio.espacio_academico}.</p>
        <p class="text-body">Docente: {sitio.docente}.</p>
        <p class="text-body">Asesora de proyecto de grado: {sitio.asesora}.</p>
        <p class="mt-2 text-body-sm text-stone-text">
          {sitio.fase}. {sitio.actividad}.
        </p>
      </div>
      <div class="rounded-soft border-2 border-ink-black bg-pure-white p-5 md:col-span-2">
        <h3 class="text-subheading font-medium">Textos e ilustraciones</h3>
        <p class="mt-3 max-w-3xl text-body">
          La fábula "El recado del trapiche", la receta, el relato "El duende del trapiche" y los
          mensajes de la Misión 3 se escribieron para este prototipo; los mensajes son inventados
          para practicar. Las ilustraciones son propias, dibujadas en SVG en estilo de libro
          ilustrado plano, a partir de la propuesta visual de la Guía 2.1. El código del sitio y los
          borradores de los textos se elaboraron con apoyo de herramientas de inteligencia artificial
          y fueron revisados por las autoras.
        </p>
      </div>
    </div>

    <div
      class="mt-8 overflow-x-auto rounded-soft border-2 border-ink-black bg-pure-white p-3 md:p-5"
      tabindex="0"
      role="region"
      aria-label="Tabla con desplazamiento horizontal"
    >
      <table class="w-full min-w-[32rem] text-left text-body-sm">
        <caption class="px-3 pb-2 pt-3 text-left text-body font-medium">
          Herramientas de software del sitio
        </caption>
        <thead>
          <tr class="border-b border-hairline-mist">
            <th scope="col" class="px-3 py-3 font-medium">Herramienta</th>
            <th scope="col" class="px-3 py-3 font-medium">Para qué se usó</th>
            <th scope="col" class="px-3 py-3 font-medium">Licencia</th>
          </tr>
        </thead>
        <tbody>
          {
            herramientas.map(([h, u, l]) => (
              <tr class="border-b border-hairline-mist last:border-0">
                <th scope="row" class="px-3 py-3 font-medium">
                  {h}
                </th>
                <td class="px-3 py-3">{u}</td>
                <td class="px-3 py-3">{l}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <ButtonGhost href="/docentes" color="sky">Ficha docente y prototipado 2.2</ButtonGhost>
      <ButtonGhost href="/" color="grass">Volver a la portada</ButtonGhost>
    </div>
  </Seccion>
</CursoLayout>

<style>
  .ref {
    padding-left: 2rem;
    text-indent: -2rem;
  }
</style>
