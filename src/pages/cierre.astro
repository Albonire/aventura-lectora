---
// station 05: the passport with its four medals, the family story for the reading circle and the certificate
import CursoLayout from '../layouts/curso_layout.astro';
import EncabezadoPagina from '../components/curso/encabezado_pagina.astro';
import Seccion from '../components/ui/seccion.astro';
import { BadgeTracker } from '../components/islas/badge_tracker';
import { RelatoFamiliar } from '../components/islas/relato_familiar';
import { Certificate } from '../components/islas/certificate';
import { estaciones } from '../config/paginas';
import { sitio } from '../config/sitio';

const estacion = estaciones[estaciones.length - 1];
---

<CursoLayout
  titulo={`${estacion.etiqueta}: ${estacion.titulo}`}
  descripcion={`Final de Aventura lectora: álbum con las cuatro medallas, historia de la familia y diploma de Detective Lector de la ${sitio.institucion_corta}.`}
  ubicacion={{ tipo: 'cierre' }}
>
  <EncabezadoPagina
    etiqueta={estacion.etiqueta}
    titulo="¡Caso resuelto!"
    color="sunshine-pop"
  >
    <p class="no-imprimir">
      Los cuentos del colegio y las historias de los abuelos quedan a salvo en el Gran Libro de la
      escuela.
    </p>
  </EncabezadoPagina>

  <Seccion id="pasaporte" titulo="Tu álbum de medallas" etiqueta="Las cuatro medallas">
    <BadgeTracker client:visible modo="pasaporte" />
  </Seccion>

  <Seccion id="relato" titulo="Para el círculo de lectura" etiqueta="Cuéntame, abuelo">
    <RelatoFamiliar client:visible />
  </Seccion>

  <Seccion id="certificado" titulo="Tu diploma" etiqueta="Diploma">
    <Certificate client:visible />
  </Seccion>
</CursoLayout>

<style is:inline>
  /* printing this page gives only the certificate, on a letter sheet in landscape */
  @page {
    size: 11in 8.5in;
    margin: 10mm;
  }
  @media print {
    #pasaporte,
    #relato,
    main > header,
    #certificado > .contenedor > header,
    #certificado section > header {
      display: none !important;
    }
    #certificado,
    #certificado .contenedor,
    #certificado section {
      margin: 0 !important;
      border: 0 !important;
      padding: 0 !important;
      max-width: none !important;
    }
    [data-certificado] {
      display: flex;
      min-height: calc(8.5in - 22mm);
      flex-direction: column;
      justify-content: center;
      margin: 0 !important;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
