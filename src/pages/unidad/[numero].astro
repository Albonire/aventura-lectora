---
import { getCollection, render } from 'astro:content';
import UnidadLayout from '../../layouts/unidad_layout.astro';

export async function getStaticPaths() {
  const unidades = await getCollection('unidades');
  return unidades.map((u) => ({ params: { numero: String(u.data.numero) }, props: { unidad: u } }));
}

const { unidad } = Astro.props;
const { Content } = await render(unidad);
---

<UnidadLayout unidad={unidad}>
  <Content />
</UnidadLayout>
