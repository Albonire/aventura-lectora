---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/base_layout.astro';

export async function getStaticPaths() {
  const unidades = await getCollection('unidades');
  return unidades.map((u) => ({ params: { numero: String(u.data.numero) }, props: { unidad: u } }));
}

const { unidad } = Astro.props;
const { Content } = await render(unidad);
---

<BaseLayout titulo={`Caso ${unidad.data.numero}: ${unidad.data.titulo}`}>
  <div class="contenedor pt-32 pb-24">
    <h1 class="text-heading-lg">
      Caso {unidad.data.numero}: {unidad.data.titulo}
    </h1>
    <div class="prosa mt-8">
      <Content />
    </div>
  </div>
</BaseLayout>
