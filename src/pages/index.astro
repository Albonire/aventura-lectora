---
import CursoLayout from '../layouts/curso_layout.astro';
import TapaLibro from '../components/libro/tapa_libro.astro';
import Seccion from '../components/ui/seccion.astro';
import ButtonGhost from '../components/ui/button_ghost.astro';
import { ReadAloud } from '../components/islas/read_aloud';
import { estaciones, id_pagina, paginas_caso, ruta_pagina } from '../config/paginas';
import { sitio } from '../config/sitio';

const discos = ['bg-sandstone', 'bg-fresh-grass', 'bg-sky-soft', 'bg-sunshine-pop', 'bg-coral-soft', 'bg-sandstone'];
const bienvenida =
  'En el salón de quinto apareció el Borracuentos: borra las ideas más importantes de los cuentos, revuelve las recetas y hace que se olviden las coplas de los abuelos. Sofía y Mateo armaron el Club de Detectives Lectores y necesitan tu ayuda. La aventura tiene seis partes cortas. En cada misión ganas una medalla para tu álbum.';
---

<CursoLayout titulo="Aventura lectora" modo="portada" ubicacion={{ tipo: 'inicio' }}>
  <TapaLibro />

  <Seccion id="bienvenida" titulo="Bienvenidos, detectives de Maripí" etiqueta={sitio.pie_portada}>
    <p class="lectura">{bienvenida}</p>
    <div class="mt-4">
      <ReadAloud client:idle texto={bienvenida} />
    </div>
    <div class="mt-6">
      <ButtonGhost href="/agencia" color="grass">Empezar la aventura</ButtonGhost>
    </div>
  </Seccion>

  <Seccion id="indice" titulo="El camino de la aventura" etiqueta="Seis partes cortas, de 15 a 20 minutos cada una">
    <div
      data-seguir-caja
      hidden
      class="mb-6 max-w-4xl rounded-soft border-2 border-ink-black bg-sunshine-pop p-5"
    >
      <p class="interfaz text-body-sm font-medium">Sigue donde ibas</p>
      <p data-seguir-texto class="mt-1 text-subheading font-bold"></p>
      <a
        data-seguir-enlace
        href="/"
        class="interfaz mt-3 inline-flex min-h-11 items-center rounded-pill border-2 border-ink-black bg-pure-white px-5 text-body-sm font-medium hover:bg-ink-black hover:text-cream-paper"
      >
        Continuar
      </a>
    </div>

    <ol data-indice-libro class="flex max-w-4xl flex-col gap-4">
      {
        estaciones.map((e, i) => (
          <li
            data-caso={e.caso}
            data-estacion={`${e.etiqueta}: ${e.titulo}`}
            data-codigo={e.codigo}
            class="rounded-soft border-2 border-ink-black bg-pure-white p-5"
          >
            <div class="flex items-start gap-4">
              <span
                class:list={[
                  'interfaz flex size-14 shrink-0 items-center justify-center rounded-full border-2 border-ink-black text-subheading font-bold',
                  discos[i],
                ]}
                aria-hidden="true"
              >
                {e.codigo}
              </span>
              <div class="min-w-0 flex-1">
                <p class="interfaz text-body-sm font-medium text-stone-text">
                  <span class="sr-only">Estación {e.codigo}: </span>
                  {e.etiqueta}
                  <span class="estado-etiqueta ml-2 text-micro" />
                </p>
                <h3 class="mt-0.5 text-[1.5rem] leading-tight">
                  {e.caso ? e.titulo : <a href={e.href} class="underline decoration-2 underline-offset-4">{e.titulo}</a>}
                </h3>
                <p class="mt-1 max-w-reading text-body">{e.resumen}</p>
                <p class="mt-1 text-body-sm text-stone-text">Ganas: {e.recompensa}</p>
              </div>
            </div>
            {e.caso && (
              <ol class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
                {paginas_caso.map((p, n) => (
                  <li>
                    <a
                      href={ruta_pagina(e.caso as number, p.slug)}
                      data-pagina={id_pagina(e.caso as number, p.slug)}
                      data-titulo={p.titulo}
                      class="interfaz flex min-h-11 items-center gap-2 rounded-pill border-2 border-ink-black bg-cream-paper px-4 py-1.5 text-body-sm font-medium hover:bg-sandstone"
                    >
                      <span class="flex-1">
                        {n + 1}. {p.titulo}
                      </span>
                      <span class="estado-pagina text-micro" />
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))
      }
    </ol>

    <p class="mt-8 max-w-3xl text-body text-stone-text">
      ¿En tu casa no hay internet? La ficha de papel de la Misión 2 está en{' '}
      <a href="/libreta" class="font-medium text-ink-black underline decoration-2 underline-offset-4"
        >Libreta de campo de Mateo</a
      >.
    </p>
  </Seccion>
</CursoLayout>
