---
// teacher sheet and documentation of activity 2.2 (prototyping): context, diagnosis of 5 May 2026,
// the seven stages of the guide, pilot findings, refinements and how to use the prototype in the classroom.
import CursoLayout from '../layouts/curso_layout.astro';
import EncabezadoPagina from '../components/curso/encabezado_pagina.astro';
import Seccion from '../components/ui/seccion.astro';
import ButtonGhost from '../components/ui/button_ghost.astro';
import { estaciones, paginas_caso } from '../config/paginas';
import { insignias } from '../lib/insignias';
import { autoras, sitio } from '../config/sitio';
import { TOTAL_GRUPO, ajustes, diagnostico, porcentaje } from '../data/prototipado';

const fondos: Record<string, string> = {
  'fresh-grass': 'bg-fresh-grass',
  'sunshine-pop': 'bg-sunshine-pop',
  'sky-soft': 'bg-sky-soft',
  'coral-soft': 'bg-coral-soft',
};

const mecanicas = [
  [
    'Narrativa',
    'El misterio de los cuentos que se borran en Maripí: el Borracuentos (el Efecto Lectura Rápida de la Guía 2.1) borra ideas, desordena recetas y hace olvidar coplas. Cada misión devuelve algo al Gran Libro de la escuela.',
  ],
  [
    'Personajes guía',
    'Sofía modela la lectura pausada y da pistas. Mateo modela la verificación y lleva la libreta de campo. Los acompañan el conejo, la tortuga y la oruga de las fábulas del salón.',
  ],
  [
    'Álbum de medallas',
    'Cuatro medallas ligadas a logros reales de lectura. Cada una muestra qué falta para ganarla.',
  ],
  [
    'Retos cortos con retroalimentación',
    'Clasificar, ordenar y elegir. El error no castiga: activa una pista de Sofía y un nuevo intento.',
  ],
  [
    'Vínculo con la familia',
    'El reto "Cuéntame, abuelo" convierte la tradición oral de las veredas en material de lectura inferencial.',
  ],
  [
    'Cierre con reconocimiento',
    'Diploma con el nombre del estudiante o de la pareja y socialización en el círculo de lectura.',
  ],
];

// names of the design document 2.1 and the simple words the students read on the web
const equivalencias: [string, string][] = [
  ['Efecto Lectura Rápida (villano)', 'El Borracuentos'],
  ['Desafío Final', 'Reto final'],
  ['Logro', 'Final'],
  ['Torre de Argumentos', 'Arma tu torre de ideas'],
  ['Agencia', 'Club de Detectives Lectores'],
  ['Estación', 'Misión o parte'],
  ['Insignia', 'Medalla'],
  ['Pasaporte', 'Álbum'],
  ['Certificado', 'Diploma'],
  ['Argumentos y postura', 'Torre de ideas y lo que pienso'],
  ['Hecho comprobable y rumor', 'Dato real y chisme'],
  ['Verificar', 'Revisar'],
  ['Relato', 'Historia'],
  ['Reenviar', 'Mandar a otros'],
];

const fortalezas = [
  'Cada estación responde a un dato del diagnóstico: nada se agregó por adorno.',
  'El recorrido completo funciona en un celular compartido, sin registro y sin enviar datos.',
  'El error se vuelve parte del aprendizaje: la pista dice dónde releer.',
  'La modalidad dual (pantalla y papel) incluye a los cuatro hogares sin conectividad.',
];
const mejoras = [
  'La voz pausada depende de las voces en español instaladas en cada aparato: hay que probarla en los celulares reales del grupo. Si el sitio tiene activada la voz natural, esta usa un servicio externo de Cloudflare que solo recibe un código de la lectura, nunca datos de los estudiantes; se apaga quitando la variable PUBLIC_TTS_URL, y si falla se usa la voz del aparato.',
  'El progreso vive en cada aparato: si dos parejas comparten un celular, hay que reiniciar el álbum entre turnos (botón más abajo).',
  'El relato de la Misión 2 es un texto escrito para el curso. Conviene reemplazarlo por relatos recogidos por los propios niños cuando existan.',
  'Las medallas premian completar los retos. La calidad de la torre de ideas la valora la docente con la lista de tres puntos.',
];
const recomendaciones = [
  'Probar la ruta completa con los 13 estudiantes y anotar el tiempo real de cada estación.',
  'Observar cuántas pistas de Sofía necesita cada pareja y en qué pregunta se detienen.',
  'Revisar con las familias si la ficha de media carta se entiende sin explicación.',
  'Guardar los relatos de "Cuéntame, abuelo" para armar, con permiso de las familias, el Gran Libro de Relatos de Maripí.',
];

const etapas = [
  { id: 'etapa-1', n: 1, titulo: 'Selección de ideas a prototipar' },
  { id: 'etapa-2', n: 2, titulo: 'Alcance del prototipo' },
  { id: 'etapa-3', n: 3, titulo: 'Prototipos iterativos' },
  { id: 'etapa-4', n: 4, titulo: 'Enfoque en la experimentación' },
  { id: 'etapa-5', n: 5, titulo: 'Pruebas y evaluación' },
  { id: 'etapa-6', n: 6, titulo: 'Refinamiento y mejora continua' },
  { id: 'etapa-7', n: 7, titulo: 'Documentación y comunicación' },
];
---

<CursoLayout
  titulo="Ficha docente y prototipado 2.2"
  descripcion="Contexto, diagnóstico del 5 de mayo de 2026, las siete etapas del prototipado, los ajustes de refinamiento y orientaciones de aula de Aventura lectora."
  titulo_cabecera="Ficha docente y prototipado 2.2"
  sin_paginador
>
  <EncabezadoPagina
    etiqueta={`${sitio.fase} · ${sitio.actividad}`}
    titulo="Ficha docente y prototipado 2.2"
    color="sky-pop"
  >
    <p>
      Qué es este prototipo, para quién se hizo y qué se ajustó en el refinamiento a partir del
      diagnóstico y de la revisión de las docentes.
    </p>
  </EncabezadoPagina>

  <Seccion id="contexto" titulo="Contexto, población y autoría" etiqueta="Datos del proyecto">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-soft border-2 border-ink-black bg-pure-white p-5">
        <h3 class="text-subheading font-medium">Institución y población</h3>
        <dl class="mt-3 space-y-2 text-body">
          <div>
            <dt class="interfaz text-body-sm font-medium text-stone-text">Institución educativa</dt>
            <dd>
              {sitio.institucion} ({sitio.sector.toLowerCase()})
            </dd>
          </div>
          <div>
            <dt class="interfaz text-body-sm font-medium text-stone-text">Municipio</dt>
            <dd>{sitio.municipio}. {sitio.contexto}.</dd>
          </div>
          <div>
            <dt class="interfaz text-body-sm font-medium text-stone-text">Población objetivo</dt>
            <dd>{sitio.poblacion}.</dd>
          </div>
        </dl>
      </div>
      <div class="rounded-soft border-2 border-ink-black bg-pure-white p-5">
        <h3 class="text-subheading font-medium">Autoría y datos académicos</h3>
        <dl class="mt-3 space-y-2 text-body">
          <div>
            <dt class="interfaz text-body-sm font-medium text-stone-text">Docentes autoras</dt>
            {autoras.map((a) => <dd>{a}</dd>)}
          </div>
          <div>
            <dt class="interfaz text-body-sm font-medium text-stone-text">Programa</dt>
            <dd>
              {sitio.universidad}, {sitio.sede} | {sitio.programa} ({sitio.anio})
            </dd>
          </div>
          <div>
            <dt class="interfaz text-body-sm font-medium text-stone-text">Espacio académico</dt>
            <dd>
              {sitio.espacio_academico} | Docente: {sitio.docente}
            </dd>
          </div>
          <div>
            <dt class="interfaz text-body-sm font-medium text-stone-text">
              Asesora de proyecto de grado
            </dt>
            <dd>{sitio.asesora}</dd>
          </div>
        </dl>
      </div>
    </div>
  </Seccion>

  <Seccion
    id="diagnostico"
    titulo={`Diagnóstico del ${sitio.fecha_diagnostico}`}
    etiqueta={`Quinto grado, n = ${TOTAL_GRUPO}`}
  >
    <p class="max-w-reading text-body">
      Registro de observación en la clase de Lengua Castellana y consulta con las {TOTAL_GRUPO} familias.
      El grupo es pequeño: cada estudiante pesa casi 8 puntos porcentuales.
    </p>
    <ul class="mt-6 flex max-w-4xl flex-col gap-4" data-diagnostico>
      {
        diagnostico.map((d) => (
          <li class="rounded-soft border-2 border-ink-black bg-pure-white p-4">
            <p class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <span class="text-body font-medium">{d.texto}</span>
              <span class="interfaz text-body font-bold tabular-nums" data-cifra={d.id}>
                {d.de_13}/{TOTAL_GRUPO}
                <span class="font-medium text-stone-text"> ({porcentaje(d.de_13)})</span>
              </span>
            </p>
            <div class="mt-3 flex gap-1" aria-hidden="true">
              {Array.from({ length: TOTAL_GRUPO }).map((_, i) => (
                <span
                  class:list={[
                    'h-4 flex-1 rounded-sm border-2 border-ink-black',
                    i < d.de_13 ? fondos[d.color] : 'bg-cream-paper',
                  ]}
                />
              ))}
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 max-w-reading text-body-sm text-stone-text">
      El detalle del trabajo de campo (bitácora, entrevista y familias) está en{' '}
      <a class="font-medium text-ink-black underline decoration-2 underline-offset-4" href="/empatizar"
        >Empatizar y definir</a
      >.
    </p>
  </Seccion>

  <Seccion id="etapas" titulo="Las siete etapas del prototipado" etiqueta="Guía de la Actividad 2.2">
    <nav aria-label="Etapas del prototipado">
      <ol class="flex flex-wrap gap-2">
        {
          etapas.map((e) => (
            <li>
              <a
                href={`#${e.id}`}
                class="interfaz inline-flex min-h-11 items-center rounded-pill border-2 border-ink-black bg-pure-white px-4 text-body-sm font-medium hover:bg-sandstone"
              >
                {e.n}. {e.titulo}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="mt-8 flex flex-col gap-10">
      <article id="etapa-1" class="scroll-mt-24">
        <h3 class="text-[1.5rem] leading-snug">1. Selección de ideas a prototipar</h3>
        <p class="mt-2 max-w-reading text-body">
          De la fase de ideación se eligieron las ideas que atacan de frente el problema: los niños
          disfrutan leer cuando hay juego, pero no encuentran la idea principal, se detienen ante las
          preguntas difíciles y casi no leen fuera del aula.
        </p>
        <ul class="mt-4 grid gap-3 md:grid-cols-2">
          {
            mecanicas.map(([titulo, texto]) => (
              <li class="rounded-soft border-2 border-ink-black bg-pure-white p-4">
                <p class="text-body font-bold">{titulo}</p>
                <p class="mt-1 text-body">{texto}</p>
              </li>
            ))
          }
        </ul>
      </article>

      <article id="etapa-2" class="scroll-mt-24">
        <h3 class="text-[1.5rem] leading-snug">2. Alcance del prototipo</h3>
        <ul class="mt-3 max-w-reading list-disc space-y-2 pl-6 text-body">
          <li>
            Prototipo de alta fidelidad: sitio web funcional que se recorre de principio a fin en un
            celular.
          </li>
          <li>
            Seis estaciones de 15 a 20 minutos. Lecturas de 150 a 250 palabras (la fábula, de máximo
            200).
          </li>
          <li>
            Sin registro, sin analítica y sin envío de datos: el progreso se guarda en el aparato.
          </li>
          <li>
            Fuera del alcance de esta versión: seguimiento del grupo en un tablero para la docente y
            banco de relatos de las familias.
          </li>
        </ul>
      </article>

      <article id="etapa-3" class="scroll-mt-24">
        <h3 class="text-[1.5rem] leading-snug">3. Prototipos iterativos</h3>
        <p class="mt-2 max-w-reading text-body">
          La primera versión tenía cinco casos extensos con videos, podcasts e infografías. La
          versión actual es la ruta de seis estaciones planeada en la Guía 2.1. Todas las misiones
          conservan los mismos cuatro pasos: {paginas_caso.map((p) => p.titulo.toLowerCase()).join(', ')}.
        </p>
        <div
          class="mt-4 overflow-x-auto rounded-soft border-2 border-ink-black bg-pure-white p-2 md:p-4"
          tabindex="0"
          role="region"
          aria-label="Tabla de estaciones con desplazamiento horizontal"
        >
          <table class="w-full min-w-[40rem] text-left text-body-sm" data-tabla-estaciones>
            <caption class="px-3 pb-2 pt-2 text-left text-body font-medium">
              Estaciones, niveles y recompensas
            </caption>
            <thead>
              <tr class="border-b-2 border-ink-black">
                <th scope="col" class="px-3 py-2 font-medium">Estación</th>
                <th scope="col" class="px-3 py-2 font-medium">Qué hace el estudiante</th>
                <th scope="col" class="px-3 py-2 font-medium">Qué trabaja</th>
                <th scope="col" class="px-3 py-2 font-medium">Qué desbloquea</th>
              </tr>
            </thead>
            <tbody>
              {
                estaciones.map((e) => (
                  <tr class="border-b border-hairline-mist align-top last:border-0">
                    <th scope="row" class="px-3 py-2 font-medium">
                      <a class="underline decoration-2 underline-offset-4" href={e.href}>
                        {e.codigo}. {e.etiqueta}: {e.titulo}
                      </a>
                    </th>
                    <td class="px-3 py-2">{e.resumen}</td>
                    <td class="px-3 py-2">{e.nivel}</td>
                    <td class="px-3 py-2">{e.recompensa}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </article>

      <article id="etapa-4" class="scroll-mt-24">
        <h3 class="text-[1.5rem] leading-snug">4. Enfoque en la experimentación</h3>
        <p class="mt-2 max-w-reading text-body">
          El prototipo está hecho para cambiarlo rápido después de cada prueba. Las lecturas, las
          preguntas y las pistas de Sofía viven en archivos de datos separados de los componentes:
          una docente puede cambiar un texto o una pista sin tocar el diseño. Cada medalla declara
          sus tareas, así que agregar o quitar un reto no rompe el álbum de medallas.
        </p>
      </article>

      <article id="etapa-5" class="scroll-mt-24">
        <h3 class="text-[1.5rem] leading-snug">5. Pruebas y evaluación</h3>
        <p class="mt-2 max-w-reading text-body">
          La prueba piloto de esta versión con estudiantes de 5.º se registra aquí cuando se haga.
          Mientras tanto, la evaluación del prototipo se apoya en el diagnóstico del 5 de mayo, en
          la revisión de las docentes y en las listas de más abajo.
        </p>
      </article>

      <article id="etapa-6" class="scroll-mt-24">
        <h3 class="text-[1.5rem] leading-snug">6. Refinamiento y mejora continua</h3>
        <p class="mt-2 max-w-reading text-body">
          Cada ajuste responde a un dato del diagnóstico, a la entrevista con la docente o a la revisión
          de las docentes, y se puede ver funcionando en el prototipo.
        </p>
        <ol class="mt-4 flex flex-col gap-3" data-ajustes>
          {
            ajustes.map((a, i) => (
              <li
                id={`ajuste-${a.id}`}
                class="grid gap-3 rounded-soft border-2 border-ink-black bg-pure-white p-4 md:grid-cols-[1fr_1fr_auto] md:items-start md:gap-5"
              >
                <div>
                  <p class="text-body font-bold">
                    {i + 1}. {a.aspecto}
                  </p>
                  <p class="mt-1 text-body">{a.hallazgo}</p>
                  <p class="interfaz mt-1 text-body-sm text-stone-text">Fuente: {a.fuente}</p>
                </div>
                <div>
                  <p class="interfaz text-body-sm font-medium text-stone-text">Ajuste realizado</p>
                  <p class="mt-1 text-body">{a.ajuste}</p>
                </div>
                <a
                  href={a.donde.href}
                  class="interfaz inline-flex min-h-11 items-center justify-center rounded-pill border-2 border-ink-black bg-cream-paper px-4 text-center text-body-sm font-medium hover:bg-sandstone"
                >
                  Ver: {a.donde.texto}
                </a>
              </li>
            ))
          }
        </ol>
      </article>

      <article id="etapa-7" class="scroll-mt-24">
        <h3 class="text-[1.5rem] leading-snug">7. Documentación y comunicación</h3>
        <p class="mt-2 max-w-reading text-body">
          Esta ficha resume las decisiones, las pruebas y los cambios. El trabajo de campo está en
          Empatizar y definir, y las fuentes consultadas, en Referencias. Las decisiones técnicas
          quedan registradas en el repositorio del proyecto.
        </p>
        <h4 class="mt-6 text-body font-bold">Nombres del documento 2.1 y nombres de la web</h4>
        <p class="mt-1 max-w-reading text-body">
          En el refinamiento se simplificaron algunos nombres para que fueran más cercanos a
          estudiantes de quinto grado. Esta tabla dice cómo se llama cada cosa en el documento 2.1 y
          cómo se llama en la web.
        </p>
        <div
          class="mt-3 overflow-x-auto rounded-soft border-2 border-ink-black bg-pure-white p-2 md:p-4"
          tabindex="0"
          role="region"
          aria-label="Tabla de nombres con desplazamiento horizontal"
        >
          <table class="w-full min-w-[32rem] text-left text-body-sm" data-tabla-nombres>
            <caption class="sr-only">Nombres del documento 2.1 y nombres de la web</caption>
            <thead>
              <tr class="border-b-2 border-ink-black">
                <th scope="col" class="px-3 py-2 font-medium">En el documento 2.1</th>
                <th scope="col" class="px-3 py-2 font-medium">En la web</th>
              </tr>
            </thead>
            <tbody>
              {
                equivalencias.map(([doc, web]) => (
                  <tr class="border-b border-hairline-mist align-top last:border-0">
                    <th scope="row" class="px-3 py-2 font-medium">{doc}</th>
                    <td class="px-3 py-2">{web}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div class="mt-4 flex flex-wrap gap-3">
          <ButtonGhost href="/empatizar" color="sun">Empatizar y definir</ButtonGhost>
          <ButtonGhost href="/referencias" color="coral">Referencias y créditos</ButtonGhost>
          <ButtonGhost href="/libreta" color="grass">Libreta de campo de Mateo</ButtonGhost>
        </div>
      </article>
    </div>
  </Seccion>

  <Seccion id="evaluacion" titulo="Evaluación del prototipo" etiqueta="Fortalezas, límites y próximos pasos">
    <div class="grid gap-4 lg:grid-cols-3">
      <div class="rounded-soft border-2 border-ink-black bg-pure-white p-5">
        <h3 class="text-subheading font-medium">Fortalezas</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-body">
          {fortalezas.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <div class="rounded-soft border-2 border-ink-black bg-pure-white p-5">
        <h3 class="text-subheading font-medium">Áreas de mejora</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-body">
          {mejoras.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <div class="rounded-soft border-2 border-ink-black bg-pure-white p-5">
        <h3 class="text-subheading font-medium">Recomendaciones para la próxima prueba</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-body">
          {recomendaciones.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>
  </Seccion>

  <Seccion id="aula" titulo="Cómo usarlo en el aula" etiqueta="Orientaciones">
    <ol class="max-w-reading list-decimal space-y-3 pl-6 text-body">
      <li>
        Hagan el Inicio y la Misión 1 en parejas dentro del salón. Ubiquen con un compañero a
        los tres estudiantes que necesitan guía paso a paso.
      </li>
      <li>
        Una estación por sesión de clase o por rato de celular en casa. No hace falta terminar la
        ruta en un día.
      </li>
      <li>
        Al cerrar el paso 3 de la Misión 2, entreguen la Libreta de campo de Mateo a los cuatro
        estudiantes sin datos en casa. Al día siguiente, ellos registran el relato en el salón.
      </li>
      <li>
        En el Reto final, pidan leer la torre de ideas en voz alta y que otro compañero
        responda con una razón.
      </li>
      <li>
        Cierren con el círculo de lectura: cada niño comparte el relato de su familia y recibe su
        certificado.
      </li>
    </ol>

    <h3 class="mt-8 text-subheading font-medium">Medallas y qué demuestra cada una</h3>
    <ul class="mt-3 grid gap-3 md:grid-cols-2">
      {
        insignias.map((i) => (
          <li class="rounded-soft border-2 border-ink-black bg-pure-white p-4">
            <p class="text-body font-bold">
              {i.nombre} <span class="font-medium text-stone-text">({i.estacion}, {i.nivel.toLowerCase()})</span>
            </p>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-body-sm">
              {i.tareas.map((t) => <li>{t.texto}</li>)}
            </ul>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 hidden max-w-reading rounded-soft border-2 border-ink-black bg-pure-white p-5 [.js_&]:block">
      <h3 class="text-subheading font-medium">Celular compartido: empezar de nuevo</h3>
      <p class="mt-2 text-body">
        El álbum de medallas se guarda en cada aparato. Si otro estudiante u otra pareja va a usar este mismo
        celular, borren aquí el progreso antes de empezar.
      </p>
      <button
        type="button"
        data-reiniciar
        class="interfaz mt-3 inline-flex min-h-11 items-center rounded-pill border-2 border-ink-black bg-coral-soft px-5 text-body-sm font-bold hover:bg-ink-black hover:text-cream-paper"
      >
        Borrar el progreso de este aparato
      </button>
      <p data-reiniciar-estado role="status" aria-live="polite" class="mt-2 min-h-6 text-body-sm"></p>
    </div>
  </Seccion>
</CursoLayout>

<script>
  import { borrar, claves_con_prefijo } from '../lib/almacen';

  // on a shared phone the next pair starts with an empty passport. Reading settings are kept.
  const boton = document.querySelector<HTMLButtonElement>('[data-reiniciar]');
  const estado = document.querySelector<HTMLElement>('[data-reiniciar-estado]');
  let confirmando = false;
  boton?.addEventListener('click', () => {
    if (!confirmando) {
      confirmando = true;
      boton.textContent = 'Sí, borrar todo el progreso';
      if (estado) estado.textContent = 'Se borran el álbum, las respuestas y las medallas. Pulsa otra vez para confirmar.';
      return;
    }
    claves_con_prefijo('')
      .filter((clave) => clave !== 'ajustes')
      .forEach((clave) => borrar(clave));
    confirmando = false;
    boton.textContent = 'Borrar el progreso de este aparato';
    if (estado) estado.textContent = 'Progreso borrado. El siguiente detective puede empezar por el Inicio.';
    document.dispatchEvent(new CustomEvent('progreso:cambio'));
  });
</script>
